use "alloc.sy"

// Growable arrays, allocated with alloc.sy. alloc.sy isn't reentrant, so
// growing a Vec can't happen in an interrupt.

// A growable array of words, like Rust's Vec<u32>. len and cap count words.
struct Vec {
    ptr: *u32
    len: u32
    cap: u32
}

// The smallest allocation for a Vec, in words
const VEC_MIN_CAP = 16

// Make room in v for extra more words, moving it to a bigger allocation if
// needed. Capacity grows by doubling. Returns nonzero on success, or 0 if
// there's no room, in which case v is unchanged.
#[align = 4]
fn vec_reserve(v: *Vec, extra: u32) -> ok {
    // alloc and free are loose, so they may clobber r4-r7
    push(r4, r5, r6, r7, r8, r9, r10, lr)
    len @r2 = v.len
    cap @r3 = v.cap
    needed @r1 = len + extra
    // Already room: return v, which is nonzero
    ok = v
    #(needed - cap)
    if #ls goto done
    v @r0 = ok
    new_cap @r10 = cap << 1
    #(new_cap - VEC_MIN_CAP)
    if #lo {
        new_cap = VEC_MIN_CAP
    }
    loop {
        #(new_cap - needed)
        if #hs goto break
        new_cap <<= 1
        goto loop
    }
    v @r8 = v
    len @r9 = len
    size @r0 = new_cap << 2
    align @r1 = 4
    block @r0 = call alloc(size, align)
    ok = block
    if ok == 0 goto done
    new @r0 = ok as *u32
    old @r1 = v.ptr
    n @r3 = len
    dst @r2 = new
    new @r9 = new
    while {
        if n == 0 goto break
    } loop {
        #(n -= 1)
        w @r4 = *old++
        nop
        *dst++ = w
        if #ne goto loop
    }
    old @r0 = v.ptr
    old_cap @r1 = v.cap
    v.ptr = new
    v.cap = new_cap
    if {
        if old_cap == 0 goto end
        size @r1 = old_cap << 2
        call free(old, size)
    }
    ok @r0 = 1
    nop
done:
    pop(r4, r5, r6, r7, r8, r9, r10, pc)
}
