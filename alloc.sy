// Our version of the linked list allocator.
//
// The list is sorted by address and starts at a dummy head with size 0,
// outside the heap. Holes are at least 8 bytes, 8 aligned.

struct Hole {
    next: *Hole
    size: u32
}

const HEAP_SIZE = 64 * 1024
#[align = 8]
static mut heap: [u32; HEAP_SIZE / 4]
static mut alloc_head: Hole

fn init_alloc() {
    head @r0 = &alloc_head
    heap @r1 = &heap as *Hole
    head.next = heap
    zero @r2 = 0
    head.size = zero
    size @r3 = HEAP_SIZE
    heap.next = zero
    heap.size = size
    bx lr
}

// Allocate size bytes aligned to align (a power of two). Returns the block
// in r0, or 0 if there's no room.
fn alloc(size: u32, align: u32) {
    head @r2 = &alloc_head
    size += 7
    cur @r3 = head.next
    #(size &= !7)
    if #eq {
        size = 8
    }
    align -= 1
    if cur == 0 goto fail
    prev @r2 = head
    loop {
        cur_size @r4 = cur.size
        next @r5 = cur.next
        #(size - cur_size)
        if #ls goto candidate
        // relabel: the old cur is now prev
        prev @r3 = cur
        #(cur @r2 = next)
        if #eq goto fail
        cur_size = cur.size
        next = cur.next
        #(size - cur_size)
        if #ls goto candidate2
try_again:
        prev @r2 = cur
        #(cur @r3 = next)
        if #ne goto loop
    }
fail:
    ret @r0 = 0
    bx lr
candidate:
    tmp @r6 = prev
    cur @r2 = cur
    prev @r3 = tmp
candidate2:
    cur_end @r7 = cur + cur_size
    if {
        #(cur & align)
        if #eq goto end
        cur_aligned @r6 = cur + align
        cur_aligned &= !align
        aligned_end @r4 = cur_aligned + size
        #(cur_end - aligned_end)
        if #lo goto try_again
        left_split_size @r1 = cur_aligned - cur
        cur.size = left_split_size
        prev.next = cur
        prev = cur
        cur = cur_aligned
    }
    alloc_end @r0 = cur + size
    #(right_split_size @r1 = cur_end - alloc_end)
    if {
        if #eq goto end
        alloc_end.next = next
        alloc_end.size = right_split_size
        next = alloc_end
    }
    prev.next = next
    r0 = cur
    bx lr
}

// Free a block allocated with this size.
fn free(ptr: *Hole, size: u32) {
    head @r2 = &alloc_head
    size += 7
    cur @r3 = head.next
    #(size &= !7)
    if #eq {
        size = 8
    }
    // Stop when cur is past ptr or null: cur - 1 >= ptr, unsigned,
    // covers both.
    prev @r2 = head
    loop {
        t @r4 = cur - 1
        #(t - ptr)
        if #hs goto break
        prev = cur
        cur = prev.next
        goto loop
    }
    // prev < ptr < cur (cur may be 0); first try to absorb cur
    ptr_end @r4 = ptr + size
    #(ptr_end - cur)
    prev_size @r5 = prev.size
    if {
        if #ne goto end
        cur_size @r4 = cur.size
        cur = cur.next
        size += cur_size
    }
    // then try to extend prev over the freed block
    prev_end @r4 = prev + prev_size
    if {
        #(prev_end - ptr)
        if #ne goto else
        prev_size += size
        prev.size = prev_size
        prev.next = cur
        bx lr
    } else {
        ptr.size = size
        ptr.next = cur
        prev.next = ptr
        bx lr
    }
}
