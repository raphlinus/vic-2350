        hi18 @s8 = hi17 + pr36
        *(g + 24) = lo
        *(g + 44) = hi
        *(g + 28) = lo16
        *(g + 40) = hi16
        *(g + 32) = lo18
        *(g + 36) = hi18
        g += 18 * 4
        ov += 9 * 4
        #(n -= 1)
        if #ne goto loop
    }
    sp += 72
    pop(r4, r5, r6, r7, r8, pc)
