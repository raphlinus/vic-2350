        t @s0 = *tw
        c @s1 = *q
        s @s2 = *(q + 36)
        t9 @s3 = *(tw + 36)
        c2 @s4 = *(q + 4)
        s_2 @s5 = *(q + 40)
        t2 @s6 = *(tw + 4)
        t9_2 @s7 = *(tw + 40)
        c3 @s8 = *(q + 8)
        s_3 @s9 = *(q + 44)
        t3 @s10 = *(tw + 8)
        t9_3 @s11 = *(tw + 44)
        sum @s12 = c * t9
        o @s1 = c * t
        pr @s0 = s * t
        pr2 @s2 = s * t9
        sum3 @s3 = c2 * t9_2
        sum @s12 = sum + pr
        pr @s0 = s_2 * t2
        o3 @s4 = c2 * t2
        sum5 @s6 = c3 * t9_3
        sum4 @s3 = sum3 - pr
        pr @s0 = s_3 * t3
        pr6 @s5 = s_2 * t9_2
        sum6 @s6 = sum5 + pr
        ovl @s0 = *ov
        wi @s7 = *win
        o5 @s8 = c3 * t3
        w9 @s10 = *(win + 36)
        pr @s9 = s_3 * t9_3
        ovl2 @s11 = *(ov + 4)
        o @s1 = o - pr2
        wi2 @s2 = *(win + 4)
        o4 @s4 = o3 + pr6
        w9_2 @s5 = *(win + 40)
        o6 @s8 = o5 - pr
        ovl3 @s9 = *(ov + 8)
        *ov = o
        c @s1 = *(q + 12)
        *(ov + 4) = o4
        s @s4 = *(q + 48)
        *(ov + 8) = o6
        wi3 @s8 = *(win + 8)
        w9_3 @s13 = *(win + 44)
        ovl4 @s14 = *(ov + 12)
        lo @s15 = ovl * wi
        hi @s0 = ovl * w9
        pr @s10 = sum * w9
        pr4 @s12 = sum * wi
        lo @s15 = lo - pr
        hi @s0 = hi + pr4
        *g = lo
        t @s7 = *(tw + 12)
        *(g + 68) = hi
        t9 @s0 = *(tw + 48)
        c5 @s10 = *(q + 16)
        s_5 @s12 = *(q + 52)
        sum @s15 = c * t9
        o @s1 = c * t
        pr @s7 = s * t
        pr14 @s4 = s * t9
        sum @s15 = sum - pr
        o @s1 = o + pr14
        wi @s0 = *(win + 12)
        *(ov + 12) = o
        w9 @s1 = *(win + 48)
        ovl @s4 = *(ov + 16)
        lo @s7 = ovl2 * wi2
        hi @s11 = ovl2 * w9_2
        pr @s5 = sum4 * w9_2
        pr8 @s3 = sum4 * wi2
        lo @s7 = lo - pr
        hi @s11 = hi + pr8
        *(g + 4) = lo
        t @s2 = *(tw + 16)
        *(g + 64) = hi
        t9 @s3 = *(tw + 52)
        c @s5 = *(q + 20)
        s @s7 = *(q + 56)
        sum9 @s11 = c5 * t9
        o @s10 = c5 * t
        pr @s2 = s_5 * t
        pr18 @s12 = s_5 * t9
        sum10 @s11 = sum9 + pr
        o @s10 = o - pr18
        wi5 @s2 = *(win + 16)
        *(ov + 16) = o
        w9_5 @s3 = *(win + 52)
        ovl6 @s10 = *(ov + 20)
        lo @s12 = ovl3 * wi3
        hi @s9 = ovl3 * w9_3
        pr @s13 = sum6 * w9_3
        pr12 @s6 = sum6 * wi3
        lo @s12 = lo - pr
        hi @s9 = hi + pr12
        *(g + 8) = lo
        t @s6 = *(tw + 20)
        *(g + 60) = hi
        t9 @s8 = *(tw + 56)
        c7 @s9 = *(q + 24)
        s_7 @s12 = *(q + 60)
        sum11 @s13 = c * t9
        o @s5 = c * t
        pr @s6 = s * t
        pr22 @s7 = s * t9
        sum12 @s13 = sum11 - pr
        o @s5 = o + pr22
        wi6 @s6 = *(win + 20)
        *(ov + 20) = o
        w9_6 @s5 = *(win + 56)
        ovl7 @s7 = *(ov + 24)
        lo @s8 = ovl4 * wi
        hi @s14 = ovl4 * w9
        pr @s1 = sum * w9
        pr16 @s15 = sum * wi
        lo @s8 = lo - pr
        hi @s14 = hi + pr16
        *(g + 12) = lo
        t @s0 = *(tw + 24)
        *(g + 56) = hi
        t9 @s1 = *(tw + 60)
        c @s8 = *(q + 28)
        s @s14 = *(q + 64)
        sum @s15 = c7 * t9
        o @s9 = c7 * t
        pr @s0 = s_7 * t
        pr26 @s12 = s_7 * t9
        sum @s15 = sum + pr
        o @s9 = o - pr26
        wi @s0 = *(win + 24)
        *(ov + 24) = o
        w9 @s1 = *(win + 60)
        ovl8 @s9 = *(ov + 28)
        lo @s12 = ovl * wi5
        hi @s4 = ovl * w9_5
        pr @s3 = sum10 * w9_5
        pr20 @s11 = sum10 * wi5
        lo @s12 = lo - pr
        hi @s4 = hi + pr20
        *(g + 16) = lo
        t @s2 = *(tw + 28)
        *(g + 52) = hi
        t9 @s3 = *(tw + 64)
        c9 @s4 = *(q + 32)
        s_9 @s11 = *(q + 68)
        sum15 @s12 = c * t9
        o @s8 = c * t
        pr @s2 = s * t
        pr30 @s14 = s * t9
        sum16 @s12 = sum15 - pr
        o @s8 = o + pr30
        wi8 @s2 = *(win + 28)
        *(ov + 28) = o
        w9_8 @s3 = *(win + 64)
        ovl @s8 = *(ov + 32)
        lo @s14 = ovl6 * wi6
        hi @s10 = ovl6 * w9_6
        pr @s5 = sum12 * w9_6
        pr24 @s13 = sum12 * wi6
        lo @s14 = lo - pr
        hi @s10 = hi + pr24
        *(g + 20) = lo
        t @s5 = *(tw + 32)
        *(g + 48) = hi
        t9 @s6 = *(tw + 68)
        sum17 @s10 = c9 * t9
        o @s4 = c9 * t
        pr @s5 = s_9 * t
        pr34 @s11 = s_9 * t9
        sum18 @s10 = sum17 + pr
        wi9 @s5 = *(win + 32)
        o @s4 = o - pr34
        w9_9 @s6 = *(win + 68)
        *(ov + 32) = o
        lo @s4 = ovl7 * wi
        hi @s7 = ovl7 * w9
        pr @s1 = sum * w9
        pr28 @s15 = sum * wi
        lo15 @s0 = ovl8 * wi8
        lo @s4 = lo - pr
        pr @s1 = sum16 * w9_8
        hi15 @s9 = ovl8 * w9_8
        pr32 @s12 = sum16 * wi8
        lo17 @s2 = ovl * wi9
        pr35 @s3 = sum18 * w9_9
        hi17 @s8 = ovl * w9_9
        pr36 @s10 = sum18 * wi9
