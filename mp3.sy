// The 12 point IMDCT of x[0], x[3], .., x[15], with overlap-add: 6
// samples to dst, and 3 to overlap
#[link_section = ".ram"]
fn mp3_imdct12(x: *f32, dst: *f32, overlap: *f32) {
    t @r3 = &mp3_twid3 as *f32
    (tw0 @s10, tw1 @s11, tw2 @s12, tw3 @s13, tw4 @s14, tw5 @s15) = *t
    x0 @s0 = *x
    x3 @s1 = *(x + 12)
    x6 @s2 = *(x + 24)
    x9 @s3 = *(x + 36)
    x12 @s4 = *(x + 48)
    x15 @s5 = *(x + 60)
    // l3_idct3(-x0, x6 + x3, x12 + x9) and l3_idct3(x15, x12 - x9, x6 - x3)
    ca @s0 = -x0
    cb @s6 = x6 + x3
    cc @s7 = x12 + x9
    sb @s8 = x12 - x9
    sc @s9 = x6 - x3
    k @s1 = 0.86602540
    half @s2 = 0.5
    m @s3 = cb * k
    a1 @s4 = cc * half
    a1 = ca - a1
    co1 @s7 = ca + cc
    co0 @s6 = a1 + m
    co2 @s0 = a1 - m
    m = sb * k
    a1 = sc * half
    a1 = x15 - a1
    si1 @s9 = x15 + sc
    si1 = -si1
    si0 @s8 = a1 + m
    si2 @s5 = a1 - m
    ovl @s1 = *overlap
    sum @s2 = co0 * tw3
    sum += si0 * tw0
    o @s3 = co0 * tw0
    o -= si0 * tw3
    *overlap = o
    d @s4 = ovl * tw2
    d -= sum * tw5
    *dst = d
    d = ovl * tw5
    d += sum * tw2
    *(dst + 20) = d
    ovl = *(overlap + 4)
    sum = co1 * tw4
    sum += si1 * tw1
    o = co1 * tw1
    o -= si1 * tw4
    *(overlap + 4) = o
    d = ovl * tw1
    d -= sum * tw4
    *(dst + 4) = d
    d = ovl * tw4
    d += sum * tw1
    *(dst + 16) = d
    ovl = *(overlap + 8)
    sum = co2 * tw5
    sum += si2 * tw2
    o = co2 * tw2
    o -= si2 * tw5
    *(overlap + 8) = o
    d = ovl * tw0
    d -= sum * tw3
    *(dst + 8) = d
    d = ovl * tw3
    d += sum * tw0
    *(dst + 12) = d
    bx lr
}

// The IMDCT of nbands short blocks
#[link_section = ".ram"]
fn mp3_imdct_short(grbuf: *f32, overlap: *f32, nbands) {
    push(r4, r5, r6, lr)
    sp -= 72 (tmp: [f32; 18])
    g @r4 = grbuf
    ov @r5 = overlap
    n @r6 = nbands
    loop {
        q @r0 = &sp.tmp as *f32
        (a0 @s0, a1 @s1, a2 @s2, a3 @s3, a4 @s4, a5 @s5, a6 @s6, a7 @s7, a8 @s8, a9 @s9, a10 @s10, a11 @s11, a12 @s12, a13 @s13, a14 @s14, a15 @s15) = *g
        *q = (a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15)
        gq @r1 = g + 64
        (a0, a1) = *gq
        q2 @r1 = q + 64
        *q2 = (a0, a1)
        (a0, a1, a2, a3, a4, a5) = *ov
        *g = (a0, a1, a2, a3, a4, a5)
        d @r1 = g + 6 * 4
        o @r2 = ov + 6 * 4
        call mp3_imdct12(q, d, o)
        q @r0 = &sp.tmp as *f32
        q += 4
        d @r1 = g + 12 * 4
        o @r2 = ov + 6 * 4
        call mp3_imdct12(q, d, o)
        q @r0 = &sp.tmp as *f32
        q += 8
        d @r1 = ov
        o @r2 = ov + 6 * 4
        call mp3_imdct12(q, d, o)
        g += 18 * 4
        ov += 9 * 4
        #(n -= 1)
        if #ne goto loop
    }
    sp += 72
    pop(r4, r5, r6, pc)
}

// Negate the odd lines of the odd bands
#[link_section = ".ram"]
fn mp3_change_sign(grbuf: *u32) {
    push(r4, r5)
    p @r0 = grbuf + 19 * 4
    j @r1 = 16
    loop {
        // 9 lines, 3 at a time
        k @r2 = 3
        loop {
            x @r3 = *p
            y @r4 = *(p + 8)
            z @r5 = *(p + 16)
            #(k -= 1)
            x ^= 0x80000000
            y ^= 0x80000000
            z ^= 0x80000000
            *p = x
            *(p + 8) = y
            *(p + 16) = z
            p += 24
            if #ne goto loop
        }
        p += 18 * 4
        #(j -= 1)
        if #ne goto loop
    }
    pop(r4, r5)
    bx lr
}

// The IMDCT of a granule: n_long_bands long blocks, then the rest as
// block_type says
#[link_section = ".text"]
fn mp3_imdct_gr(grbuf: *f32, overlap: *f32, block_type, n_long_bands) {
    push(r4, r5, r6, r7, r8, lr)
    g @r4 = grbuf
    ov @r5 = overlap
    bt @r6 = block_type
    nl @r7 = n_long_bands
    if {
        if nl == 0 goto end
        w @r2 = &mp3_mdct_window as *f32
        call mp3_imdct36(grbuf, overlap, w, n_long_bands)
    }
    t @r0 = nl << 6
    t = t + (nl << 3)
    g += t
    t = nl << 5
    t = t + (nl << 2)
    ov += t
    rest @r8 = 32 - nl
    if {
        #(bt - SHORT_BLOCK_TYPE)
        if #ne goto else
        a @r0 = g
        b @r1 = ov
        c @r2 = rest
        call mp3_imdct_short(a, b, c)
        goto end
    } else {
        a @r0 = g
        b @r1 = ov
        w @r2 = &mp3_mdct_window as *f32
        #(bt - STOP_BLOCK_TYPE)
        if #eq {
            w += 18 * 4
        }
        c @r3 = rest
        call mp3_imdct36(a, b, w, c)
    }
    pop(r4, r5, r6, r7, r8, pc)
}

// Polyphase synthesis of a granule, from mp3_scratch.grbuf to nch
// interleaved channels at pcm
#[link_section = ".text"]
fn mp3_synth_granule(nch, pcm: *i16) {
    push(r4, r5, r6, r7, r8, lr)
    n @r4 = nch
    out @r5 = pcm
    g @r0 = &mp3_scratch.grbuf as *f32
    call mp3_dct_ii(g)
    if {
        #(n - 2)
        if #ne goto end
        g @r0 = &mp3_scratch.grbuf as *f32
        g += 576 * 4
        call mp3_dct_ii(g)
    }
    band @r6 = 0
    lins @r7 = &mp3_decoder.syn as *f32
    loop {
        a @r0 = band
        o @r1 = out
        c @r2 = n
        l @r3 = lins
        call mp3_synth(a, o, c, l)
        t @r0 = n << 7
        out += t
        lins += 128 * 4
        band += 2
        #(band - 18)
        if #lo goto loop
    }
    // the history for the next granule to the front
    d @r0 = &mp3_decoder.syn as *u32
    s @r1 = d + 1152 * 4
    if {
        #(n - 1)
        if #ne goto else
        // only the even ones
        c @r2 = 480
        loop {
            x @r3 = *s
            s += 8
            *d = x
            d += 8
            #(c -= 1)
            if #ne goto loop
        }
        goto end
    } else {
        c @r2 = 960
        call mp3_copy_words(d, s, c)
    }
    pop(r4, r5, r6, r7, r8, pc)
}

// The 32 point DCT-II across the subbands, for each of the 18 lines
#[link_section = ".ram"]
fn mp3_dct_ii(grbuf: *f32) {
    push(r4, r5, r6, r7, r8)
    push(s16, s17, s18, s19, s20, s21, s22, s23, s24)
    sp -= 128 (t: [f32; 32])
    kp @r1 = &mp3_dct8_k as *f32
    (k0 @s16, k1 @s17, k2 @s18, k3 @s19, k4 @s20, k5 @s21, k6 @s22, k7 @s23, k8 @s24) = *kp
    p @r0 = grbuf
    kc @r1 = 18
    // Each loop ends with a 16 bit add of a stride in a register, which
    // doesn't set flags, so that the branch folds with it.
    row @r2 = 72
    // The ops below are in mp3dec's order for each value, but interleaved,
    // so that no result is used by the very next instruction.
    loop {
        q0 @r8 = p
        q1 @r3 = p + 15 * 72
        q2 @r12 = p + 16 * 72
        q3 @r4 = p + 31 * 72
        sec @r5 = &mp3_sec as *f32
        tp @r6 = &sp.t as *f32
        i @r7 = 8
        loop {
            #(i -= 1)
            x0 @s0 = *q0
            x1 @s1 = *q1
            x2 @s2 = *q2
            x3 @s3 = *q3
            (c0 @s4, c1 @s5, c2 @s6) = *sec++
            t0 @s7 = x0 + x3
            t1 @s8 = x1 + x2
            t2 @s9 = x1 - x2
            t3 @s10 = x0 - x3
            u @s11 = t0 + t1
            v @s12 = t0 - t1
            t2 = t2 * c0
            t3 = t3 * c1
            *tp++ = u
            v = v * c2
            u2 @s13 = t3 + t2
            v2 @s14 = t3 - t2
            *(tp + 28) = v
            v2 = v2 * c2
            *(tp + 60) = u2
            q0 += row
            q1 -= 72
            *(tp + 92) = v2
            q3 -= 72
            q2 += row
            if #ne goto loop
        }
        // an 8 point DCT of each row of t, with the results in s8-s15 in
        // order, for one store
        tp = &sp.t as *f32
        i = 4
        step @r3 = 32
        loop {
            #(i -= 1)
            (x0 @s0, x1 @s1, x2 @s2, x3 @s3, x4 @s4, x5 @s5, x6 @s6, x7 @s7) = *tp
            x3a @s9 = x3 + x4
            x5a @s4 = x3 - x4
            x2a @s3 = x2 + x5
            x6a @s5 = x2 - x5
            x0a @s2 = x0 + x7
            xt @s0 = x0 - x7
            x1a @s7 = x1 + x6
            x7a @s1 = x1 - x6
            x4b @s6 = x0a - x3a
            x0b @s2 = x0a + x3a
            x5b @s4 = x5a + x6a
            x7b @s9 = x7a + xt
            x3b @s10 = x1a - x2a
            m @s11 = x7b * k1
            x1b @s7 = x1a + x2a
            x5c @s4 = x5b - m
            x6b @s5 = x6a + x7a
            x3c @s10 = x3b + x4b
            m = x5c * k2
            y0 @s8 = x0b + x1b
            x6c @s5 = x6b * k0
            x7c @s1 = x7b + m
            y4 @s12 = x0b - x1b
            m = x7c * k1
            x3d @s10 = x3c * k0
            y4 = y4 * k0
            x5d @s4 = x5c - m
            x0c @s2 = xt - x6c
            xtb @s0 = xt + x6c
            w2 @s3 = x4b + x3d
            y6 @s14 = x4b - x3d
            w3 @s6 = x0c - x5d
            w5 @s7 = x0c + x5d
            y1 @s9 = xtb + x7c
            y7 @s15 = xtb - x7c
            y2 @s10 = w2 * k4
            y6 = y6 * k7
            y3 @s11 = w3 * k5
            y5 @s13 = w5 * k6
            y1 = y1 * k3
            y7 = y7 * k8
            *tp = (y0, y1, y2, y3, y4, y5, y6, y7)
            tp += step
            if #ne goto loop
        }
        // back to the subbands
        o @r8 = p
        tp = &sp.t as *f32
        i = 7
        step = 288
        loop {
            #(i -= 1)
            a @s0 = *tp++
            t2i @s1 = *(tp + 60)
            t3i @s2 = *(tp + 92)
            t3n @s3 = *(tp + 96)
            t1i @s5 = *(tp + 28)
            t1n @s6 = *(tp + 32)
            t2n @s8 = *(tp + 64)
            v @s4 = t2i + t3i
            u @s7 = t1i + t1n
            v2 @s9 = t2n + t3i
            v = v + t3n
            *o = a
            v2 = v2 + t3n
            *(o + 144) = u
            *(o + 72) = v
            *(o + 216) = v2
            o += step
            if #ne goto loop
        }
        a @s0 = *tp
        t2i @s1 = *(tp + 64)
        t3i @s2 = *(tp + 96)
        t1i @s5 = *(tp + 32)
        v @s4 = t2i + t3i
        p += 4
        #(kc -= 1)
        *o = a
        *(o + 144) = t1i
        *(o + 216) = t3i
        *(o + 72) = v
        if #ne goto loop
    }
    sp += 128
    pop(s16, s17, s18, s19, s20, s21, s22, s23, s24)
    pop(r4, r5, r6, r7, r8)
    bx lr
}

// The two outputs of a subband pair that need only the history: pcm[0]
// from z[64 k], and pcm[16 nch] from z[64 k + 2]
#[link_section = ".ram"]
fn mp3_synth_pair(pcm: *i16, nch, z: *f32) {
    push(r4, r5, r6, r7)
    k @r5 = &mp3_synth_k as *f32
    (k0 @s8, k1 @s9, k2 @s10, k3 @s11, k4 @s12, k5 @s13, k6 @s14, k7 @s15) = *k++
    zb @r3 = z + 4 * 64 * 4
    zc @r12 = z + 8 * 64 * 4
    zd @r4 = z + 12 * 64 * 4
    // a = sum of d_i * k_i in order, each d_i the sum or difference of a
    // pair. vmla rounds the product, so this is the same as mp3dec's, but
    // pipelined: the loads of one term, the d of the next and the product
    // of the one before, three registers apart.
    x0 @s0 = *(zd + 512)
    y0 @s1 = *z
    x1 @s2 = *(z + 256)
    y1 @s3 = *(zd + 256)
    d0 @s0 = x0 - y0
    x2 @s4 = *zd
    y2 @s5 = *(z + 512)
    d1 @s2 = x1 + y1
    a @s7 = d0 * k0
    m1 @s3 = d1 * k1
    x3 @s0 = *(z + 768)
    y3 @s1 = *(zc + 768)
    d2 @s4 = x2 - y2
    a = a + m1
    m2 @s5 = d2 * k2
    x4 @s2 = *(zc + 512)
    y4 @s3 = *zb
    d3 @s0 = x3 + y3
    a = a + m2
    m3 @s1 = d3 * k3
    x5 @s4 = *(zb + 256)
    y5 @s5 = *(zc + 256)
    d4 @s2 = x4 - y4
    a = a + m3
    m4 @s3 = d4 * k4
    x6 @s0 = *zc
    y6 @s1 = *(zb + 512)
    d5 @s4 = x5 + y5
    a = a + m4
    m5 @s5 = d5 * k5
    x7 @s2 = *(zb + 768)
    d6 @s0 = x6 - y6
    a = a + m5
    m6 @s1 = d6 * k6
    m7 @s2 = x7 * k7
    a = a + m6
    (j0 @s8, j1 @s9, j2 @s10, j3 @s11, j4 @s12, j5 @s13, j6 @s14, j7 @s15) = *k++
    (lo @s4, hi @s5, half @s6) = *k
    a = a + m7
    // b = sum of z_j * j_j, with a's conversion to i16 in between
    u0 @s0 = *(zd + 520)
    u1 @s1 = *(zd + 8)
    cl @s2 = max(a, lo)
    b @s7 = u0 * j0
    n1 @s1 = u1 * j1
    u2 @s0 = *(zc + 520)
    cl = min(cl, hi)
    b = b + n1
    n2 @s0 = u2 * j2
    u3 @s1 = *(zc + 8)
    cl = cl + half
    b = b + n2
    n3 @s1 = u3 * j3
    u4 @s0 = *(zb + 520)
    ci @s3 = f32_to_i32(cl)
    b = b + n3
    n4 @s0 = u4 * j4
    u5 @s1 = *(zb + 8)
    v @r5 = ci
    b = b + n4
    n5 @s1 = u5 * j5
    u6 @s0 = *(z + 520)
    sgn @r6 = to_bits(cl)
    b = b + n5
    n6 @s0 = u6 * j6
    u7 @s1 = *(z + 8)
    v = v + ((sgn as i32) >> 31)
    b = b + n6
    n7 @s1 = u7 * j7
    *pcm = v
    off @r1 = nch << 5
    b = b + n7
    cl = max(b, lo)
    cl = min(cl, hi)
    cl = cl + half
    ci = f32_to_i32(cl)
    sgn = to_bits(cl)
    v = ci
    v = v + ((sgn as i32) >> 31)
    *(pcm + off) = v
    pop(r4, r5, r6, r7)
    bx lr
}

// Synthesis of the subband pair band, band + 1 (of both channels), into
// 64 samples per channel at dst. lins is the synthesis buffer: 960 floats
// of history, then this pair's new values.
#[link_section = ".ram"]
fn mp3_synth(band, dst: *i16, nch, lins: *f32) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    push(s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31)
    sp -= 4
    gl @r6 = &mp3_scratch.grbuf as *f32
    gl = gl + (band << 2)
    out @r7 = dst
    n @r4 = nch
    zl @r10 = lins
    // the right channel's offset from the left
    roff @r8 = 0
    #(n - 2)
    if #eq {
        roff = 576 * 4
    }
    gr @r12 = gl + roff
    a @r0 = *(gl + 16 * 18 * 4)
    b @r1 = *(gr + 16 * 18 * 4)
    c @r2 = *gl
    d @r3 = *gr
    z @r5 = zl + (960 + 4 * 15) * 4
    *z = (a, b, c, d)
    a = *(gl + (16 * 18 + 1) * 4)
    b = *(gr + (16 * 18 + 1) * 4)
    c = *(gl + 4)
    d = *(gr + 4)
    z += 16 * 4 * 4
    *z = (a, b, c, d)
    // the outputs for the right channel first, which in mono the left's
    // overwrite
    if {
        #(n - 2)
        if #ne goto end
        p @r0 = out + 2
        nc @r1 = n
        z @r2 = zl + (4 * 15 + 1) * 4
        call mp3_synth_pair(p, nc, z)
        p @r0 = out + 130
        nc @r1 = n
        z @r2 = zl + (4 * 15 + 64 + 1) * 4
        call mp3_synth_pair(p, nc, z)
    }
    p @r0 = out
    nc @r1 = n
    z @r2 = zl + 4 * 15 * 4
    call mp3_synth_pair(p, nc, z)
    t @r0 = n << 6
    p @r0 = out + t
    nc @r1 = n
    z @r2 = zl + (4 * 15 + 64) * 4
    call mp3_synth_pair(p, nc, z)
    k @r0 = &mp3_synth_k as *f32
    k += 16 * 4
    (lo @s28, hi @s29, half @s30) = *k
    // i from 14 down to 0
    pp @r9 = zl + (960 + 4 * 14) * 4
    end @lr = zl + (960 - 4) * 4
    gb @r12 = gl + 18 * 15 * 4
    ga @r6 = gl + 18 * 17 * 4
    wp @r11 = &mp3_win as *f32
    t @r0 = n << 6
    t -= n << 1
    o2 @r1 = out + t
    t = n << 1
    o1 @r7 = out + t
    n @r10 = n
    o2 @r4 = o2
    loop {
        // the new values for this i
        (v0 @r0, v2 @r2) = *ga
        gt @r5 = ga + roff
        (v1 @r1, v3 @r3) = *gt
        *pp = (v0, v1, v2, v3)
        (v0, v2) = *gb
        gt = gb + roff
        (v1, v3) = *gt
        *(pp + 256) = (v2, v3)
        *(pp - 248) = (v0, v1)
        zero @r0 = 0
        a0 @s16 = from_bits(zero)
        a1 @s17 = from_bits(zero)
        a2 @s18 = from_bits(zero)
        a3 @s19 = from_bits(zero)
        b0 @s20 = from_bits(zero)
        b1 @s21 = from_bits(zero)
        b2 @s22 = from_bits(zero)
        b3 @s23 = from_bits(zero)
        zp @r1 = pp
        yp @r2 = pp - 15 * 64 * 4
        kc @r3 = 4
        if {
            #(n - 2)
            if #eq goto else
            // mono: only lanes 0 and 2 reach the output, as mp3dec keeps
            // only their history
            loop {
                #(kc -= 1)
                zq @r0 = zp - 64 * 4
                yq @r5 = yp + 64 * 4
                (w0 @s24, w1 @s25, w2 @s26, w3 @s27) = *wp++
                z0 @s0 = *zp
                z2 @s2 = *(zp + 8)
                y0 @s4 = *yp
                y2 @s6 = *(yp + 8)
                m @s8 = z0 * w1
                m2 @s9 = y0 * w0
                nn @s10 = z0 * w0
                n2 @s11 = y0 * w1
                m = m + m2
                nn = nn - n2
                b0 = b0 + m
                a0 = a0 + nn
                m @s8 = z2 * w1
                m2 @s9 = y2 * w0
                nn @s10 = z2 * w0
                n2 @s11 = y2 * w1
                m = m + m2
                nn = nn - n2
                b2 = b2 + m
                a2 = a2 + nn
                z0 = *zq
                z2 = *(zq + 8)
                y0 = *yq
                y2 = *(yq + 8)
                m @s8 = z0 * w3
                m2 @s9 = y0 * w2
                nn @s10 = y0 * w3
                n2 @s11 = z0 * w2
                m = m + m2
                nn = nn - n2
                b0 = b0 + m
                a0 = a0 + nn
                m @s8 = z2 * w3
                m2 @s9 = y2 * w2
                nn @s10 = y2 * w3
                n2 @s11 = z2 * w2
                m = m + m2
                nn = nn - n2
                b2 = b2 + m
                a2 = a2 + nn
                zp -= 128 * 4
                yp += 128 * 4
                if #ne goto loop
            }
            goto end
        } else {
            loop {
                #(kc -= 1)
                zq @r0 = zp - 64 * 4
                yq @r5 = yp + 64 * 4
                (w0 @s24, w1 @s25, w2 @s26, w3 @s27) = *wp++
                (z0 @s0, z1 @s1, z2 @s2, z3 @s3) = *zp
                (y0 @s4, y1 @s5, y2 @s6, y3 @s7) = *yp
                m @s8 = z0 * w1
                m2 @s9 = y0 * w0
                nn @s10 = z0 * w0
                n2 @s11 = y0 * w1
                m = m + m2
                nn = nn - n2
                b0 = b0 + m
                a0 = a0 + nn
                m @s12 = z1 * w1
                m2 @s13 = y1 * w0
                nn @s14 = z1 * w0
                n2 @s15 = y1 * w1
                m = m + m2
                nn = nn - n2
                b1 = b1 + m
                a1 = a1 + nn
                m @s8 = z2 * w1
                m2 @s9 = y2 * w0
                nn @s10 = z2 * w0
                n2 @s11 = y2 * w1
                m = m + m2
                nn = nn - n2
                b2 = b2 + m
                a2 = a2 + nn
                m @s12 = z3 * w1
                m2 @s13 = y3 * w0
                nn @s14 = z3 * w0
                n2 @s15 = y3 * w1
                m = m + m2
                nn = nn - n2
                b3 = b3 + m
                a3 = a3 + nn
                (z0, z1, z2, z3) = *zq
                (y0, y1, y2, y3) = *yq
                m @s8 = z0 * w3
                m2 @s9 = y0 * w2
                nn @s10 = y0 * w3
                n2 @s11 = z0 * w2
                m = m + m2
                nn = nn - n2
                b0 = b0 + m
                a0 = a0 + nn
                m @s12 = z1 * w3
                m2 @s13 = y1 * w2
                nn @s14 = y1 * w3
                n2 @s15 = z1 * w2
                m = m + m2
                nn = nn - n2
                b1 = b1 + m
                a1 = a1 + nn
                m @s8 = z2 * w3
                m2 @s9 = y2 * w2
                nn @s10 = y2 * w3
                n2 @s11 = z2 * w2
                m = m + m2
                nn = nn - n2
                b2 = b2 + m
                a2 = a2 + nn
                m @s12 = z3 * w3
                m2 @s13 = y3 * w2
                nn @s14 = y3 * w3
                n2 @s15 = z3 * w2
                m = m + m2
                nn = nn - n2
                b3 = b3 + m
                a3 = a3 + nn
                zp -= 128 * 4
                yp += 128 * 4
                if #ne goto loop
            }
        }
        // a0, b0, a2, b2 go to the left channel, or both when mono, and
        // a1, b1, a3, b3 to the right. Four at a time, so that each op's
        // result is ready by its next use.
        t @r5 = n << 6
        cx0 @s0 = max(a0, lo)
        cx1 @s1 = max(b0, lo)
        cx2 @s2 = max(a2, lo)
        cx3 @s3 = max(b2, lo)
        cx0 = min(cx0, hi)
        cx1 = min(cx1, hi)
        cx2 = min(cx2, hi)
        cx3 = min(cx3, hi)
        cx0 = cx0 + half
        cx1 = cx1 + half
        cx2 = cx2 + half
        cx3 = cx3 + half
        ix0 @s4 = f32_to_i32(cx0)
        ix1 @s5 = f32_to_i32(cx1)
        ix2 @s6 = f32_to_i32(cx2)
        ix3 @s7 = f32_to_i32(cx3)
        u0 @r0 = ix0
        sg0 @r1 = to_bits(cx0)
        u1 @r2 = ix1
        sg1 @r3 = to_bits(cx1)
        u0 = u0 + ((sg0 as i32) >> 31)
        u1 = u1 + ((sg1 as i32) >> 31)
        *o1 = u0
        *o2 = u1
        u0 = ix2
        sg0 = to_bits(cx2)
        u1 = ix3
        sg1 = to_bits(cx3)
        u0 = u0 + ((sg0 as i32) >> 31)
        u1 = u1 + ((sg1 as i32) >> 31)
        *(o1 + t) = u0
        *(o2 + t) = u1
        #(n - 2)
        if #ne goto mono
        t += 2
        cx0 = max(a1, lo)
        cx1 = max(b1, lo)
        cx2 = max(a3, lo)
        cx3 = max(b3, lo)
        cx0 = min(cx0, hi)
        cx1 = min(cx1, hi)
        cx2 = min(cx2, hi)
        cx3 = min(cx3, hi)
        cx0 = cx0 + half
        cx1 = cx1 + half
        cx2 = cx2 + half
        cx3 = cx3 + half
        ix0 = f32_to_i32(cx0)
        ix1 = f32_to_i32(cx1)
        ix2 = f32_to_i32(cx2)
        ix3 = f32_to_i32(cx3)
        u0 = ix0
        sg0 = to_bits(cx0)
        u1 = ix1
        sg1 = to_bits(cx1)
        u0 = u0 + ((sg0 as i32) >> 31)
        u1 = u1 + ((sg1 as i32) >> 31)
        *(o1 + 2) = u0
        *(o2 + 2) = u1
        u0 = ix2
        sg0 = to_bits(cx2)
        u1 = ix3
        sg1 = to_bits(cx3)
        u0 = u0 + ((sg0 as i32) >> 31)
        u1 = u1 + ((sg1 as i32) >> 31)
        *(o1 + t) = u0
        *(o2 + t) = u1
    mono:
        o1 = o1 + (n << 1)
        o2 = o2 - (n << 1)
        ga += 18 * 4
        gb -= 18 * 4
        pp -= 16
        #(pp - end)
        if #ne goto loop
    }
    sp += 4
    pop(s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31)
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}
