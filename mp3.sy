use "mp3_tables.sy"

// An MP3 (MPEG-1/2/2.5 Layer III) decoder, a port of mp3dec (itself a
// port of minimp3), with the same results bit for bit. Layers I and II
// are recognized but not decoded.
//
// Call mp3_decode_frame(mp3, len, pcm, info) with the rest of the stream
// in mp3. It decodes the first frame, skipping any junk before it, and
// returns the number of samples per channel, 0 if no frame was decoded
// (no sync, layer 1 or 2, or the bit reservoir isn't filled yet, as after
// a seek). The samples are interleaved i16s, up to MP3_MAX_SAMPLES. In
// either case, advance by info.frame_bytes. With pcm 0, only the header
// is parsed.
//
// There's one decoder, in mp3_decoder, with its scratch memory in
// mp3_scratch. mp3_init resets it.
//
// Each function is in its own section, so its literal pool is right
// after it, and the hot ones are in RAM.

const MP3_MAX_SAMPLES = 1152 * 2

const HDR_SIZE = 4
const MAX_FREE_FORMAT_FRAME_SIZE = 2304
const MAX_FRAME_SYNC_MATCHES = 10
const MAX_BITRESERVOIR_BYTES = 511
const MAINDATA_BYTES = MAX_BITRESERVOIR_BYTES + MAX_FREE_FORMAT_FRAME_SIZE
const SHORT_BLOCK_TYPE = 2
const STOP_BLOCK_TYPE = 3
const L3_ERROR = 0xffffffff

// Header bits. The header is kept as one word, its first byte on top, so
// bit k of byte i is bit 8 * (3 - i) + k.
const HDR_CRC_ABSENT = 1 << 16
const HDR_MPEG1 = 1 << 19
const HDR_NOT_MPEG25 = 1 << 20
const HDR_PADDING = 1 << 9
const HDR_I_STEREO = 1 << 4
const HDR_MS_STEREO = 1 << 5
// Joint stereo with M/S: the mode and HDR_MS_STEREO, masked by 0xe0
const HDR_JOINT_MS = 0x60
// The channel mode, mono when both bits are set
const HDR_MODE = 0xc0

struct Mp3Info {
    // Bytes consumed, including any skipped junk; advance input by this
    frame_bytes: u32
    // Offset of the frame header within the input
    frame_offset: u32
    // 1 or 2
    channels: u32
    hz: u32
    // MPEG layer (1-3); only layer 3 is decoded
    layer: u32
    bitrate_kbps: u32
}

// State carried between frames
struct Mp3Decoder {
    reserv: u32
    free_format_bytes: u32
    // 0 until a frame is found
    header: u32
    // to a multiple of 16 bytes, for mp3_zero
    pad: u32
    reserv_buf: [u8; 512]
    mdct_overlap: [f32; 576]
    // the synthesis buffer: 960 floats of QMF history, kept from granule
    // to granule, then each granule's 1152 new values, also scratch for
    // mp3_reorder
    syn: [f32; 2112]
}

// A bit reader: pos and limit count bits from buf
struct Mp3Bs {
    buf: *u8
    pos: u32
    limit: u32
}

// Side information for one granule of one channel
struct Mp3Gr {
    // band widths, from mp3_scf_long, mp3_scf_short or mp3_scf_mixed
    sfbtab: *u8
    part_23_length: u16
    big_values: u16
    scalefac_compress: u16
    global_gain: u8
    block_type: u8
    mixed_block_flag: u8
    n_long_sfb: u8
    n_short_sfb: u8
    table_select: [u8; 3]
    region_count: [u8; 3]
    subblock_gain: [u8; 3]
    preflag: u8
    scalefac_scale: u8
    count1_table: u8
    scfsi: u8
}

// Memory for one frame. gr_info, scf and ist_pos are cleared at the start
// of each frame, as one block. maindata ends with zeros, which the
// Huffman decoder can read past the main data in a broken stream; the
// bytes from dirty on are zero.
struct Mp3Scratch {
    bs: Mp3Bs
    dirty: u32
    gr_info: [Mp3Gr; 4]
    scf: [f32; 40]
    // [[u8; 39]; 2], padded
    ist_pos: [u8; 80]
    grbuf: [f32; 1152]
    maindata: [u8; 4864]
}

const SCRATCH_CLEAR_WORDS = (size(Mp3Gr) * 4 + 160 + 80) / 4

static mut mp3_decoder: Mp3Decoder
static mut mp3_scratch: Mp3Scratch

// Constants for the functions below that are too long for a literal pool
static mp3_pow43_k: [f32; 4] = [16.0, 256.0, 1.3333334, 0.22222222]
static mp3_dct9_k: [f32; 8] = [
    0.5, 0.93969262, 0.76604444, 0.17364818, 0.86602540, 0.98480775, 0.34202014, 0.64278761,
]
static mp3_dct8_k: [f32; 9] = [
    0.70710677, 0.198912367, 0.382683432, 0.50979561, 0.54119611, 0.60134488, 0.89997619,
    1.30656302, 2.56291556,
]
// The second half of mp3_synth_pair's window, and mp3_scale_pcm's
// clamp range
static mp3_synth_k: [f32; 19] = [
    29.0, 213.0, 459.0, 2037.0, 5153.0, 6574.0, 37489.0, 75038.0,
    104.0, 1567.0, 9727.0, 64019.0, -9975.0, -45.0, 146.0, -5.0,
    -32767.5, 32766.5, 0.5,
]

// Reset the decoder, as before the first frame
#[link_section = ".text"]
fn mp3_init() {
    p @r0 = &mp3_decoder as *u32
    n @r1 = size(Mp3Decoder) / 4
    #[tail] call mp3_zero(p, n)
}

// Zero n words at p, n a nonzero multiple of 4: 8 at a time, then 4 if
// left
#[link_section = ".ram"]
fn mp3_zero(p: *u32, n) {
    push(r4, r5, r6, r7, lr)
    a @r2 = 0
    b @r3 = 0
    c @r4 = 0
    d @r5 = 0
    e @r6 = 0
    f @r7 = 0
    g @r12 = 0
    h @lr = 0
    #(n -= 8)
    if #lo goto four
    loop {
        #(n -= 8)
        *p++ = (a, b, c, d, e, f, g, h)
        if #hs goto loop
    }
four:
    #(n += 8)
    if #eq goto done
    *p++ = (a, b, c, d)
done:
    pop(r4, r5, r6, r7, pc)
}

// Copy n words from src to dst, n a nonzero multiple of 4: 8 at a time,
// then 4 if left
#[link_section = ".ram"]
fn mp3_copy_words(dst: *u32, src: *u32, n) {
    push(r4, r5, r6, r7, r8, lr)
    #(n -= 8)
    if #lo goto four
    loop {
        #(n -= 8)
        (a @r3, b @r4, c @r5, d @r6, e @r7, f @r8, g @r12, h @lr) = *src++
        *dst++ = (a, b, c, d, e, f, g, h)
        if #hs goto loop
    }
four:
    #(n += 8)
    if #eq goto done
    (a @r3, b @r4, c @r5, d @r6) = *src++
    *dst++ = (a, b, c, d)
done:
    pop(r4, r5, r6, r7, r8, pc)
}

// Copy n bytes from src to dst, 8 at a time with word loads and stores,
// which may be unaligned
#[link_section = ".text"]
fn mp3_copy(dst: *u8, src: *u8, n) {
    #(n -= 8)
    if #lo goto tail
    loop {
        a @r3 = *(src as *u32)
        b @r12 = *((src + 4) as *u32)
        src += 8
        *(dst as *u32) = a
        *((dst + 4) as *u32) = b
        dst += 8
        #(n -= 8)
        if #hs goto loop
    }
tail:
    n += 8
    if n == 0 goto done
    loop {
        c @r3 = *src++
        *dst++ = c
        #(n -= 1)
        if #ne goto loop
    }
done:
    bx lr
}

// Header fields

#[link_section = ".text"]
fn mp3_hdr_valid(h) -> ok {
    b @r1 = h >> 24
    #(b - 0xff)
    if #ne goto no
    b = h[16..24]
    t @r2 = b & 0xf0
    #(t - 0xf0)
    if #eq goto sync
    t = b & 0xfe
    #(t - 0xe2)
    if #ne goto no
sync:
    // layer, bitrate and sample rate
    t = h[17..19]
    if t == 0 goto no
    t = h[12..16]
    #(t - 15)
    if #eq goto no
    t = h[10..12]
    #(t - 3)
    if #eq goto no
    ok = 1
    bx lr
no:
    ok = 0
    bx lr
}

// Whether other is a valid header for a frame of the same stream as h
#[link_section = ".text"]
fn mp3_hdr_compare(h, other) -> ok {
    x @r2 = h ^ other
    #(x & 0xfe0000)
    if #ne goto no
    #(x & 0xc00)
    if #ne goto no
    // both free format, or neither
    a @r2 = h & 0xf000
    b @r3 = other & 0xf000
    if {
        if a == 0 goto else
        if b == 0 goto no
        goto end
    } else {
        if b != 0 goto no
    }
    o @r0 = other
    #[tail] call mp3_hdr_valid(o)
no:
    ok = 0
    bx lr
}

#[link_section = ".text"]
fn mp3_hdr_kbps(h) -> kbps {
    // mp3_halfrate[mpeg1][layer - 1][bitrate]
    m @r1 = h[19..20]
    i @r2 = m + (m << 1)
    l @r3 = h[17..19]
    i += l
    i -= 1
    i = (i << 4) - i
    b @r3 = h[12..16]
    i += b
    t @r3 = &mp3_halfrate as *u8
    k @r3 = *(t + i)
    kbps = k << 1
    bx lr
}

#[link_section = ".text"]
fn mp3_hdr_hz(h) -> hz {
    sr @r1 = h[10..12]
    t @r2 = &mp3_hz as *u32
    v @r2 = *(t + sr * 4)
    m @r1 = h[19..20]
    m ^= 1
    v >>= m
    m = h[20..21]
    m ^= 1
    hz = v >> m
    bx lr
}

// Samples per channel in a frame
#[link_section = ".text"]
fn mp3_hdr_samples(h) -> n {
    l @r1 = h[17..19]
    #(l - 3)
    if #eq goto layer1
    f @r1 = h[17..20]
    n = 1152
    #(f - 1)
    if #eq {
        n = 576
    }
    bx lr
layer1:
    n = 384
    bx lr
}

#[link_section = ".text"]
fn mp3_hdr_padding(h) -> n {
    #(h & HDR_PADDING)
    if #eq goto none
    l @r1 = h[17..19]
    n = 1
    #(l - 3)
    if #eq {
        n = 4
    }
    bx lr
none:
    n = 0
    bx lr
}

// The frame size without padding, or free, the free format frame size,
// for a free format frame
#[link_section = ".text"]
fn mp3_hdr_frame_bytes(h, free) -> n {
    push(r4, r5, r6, lr)
    hh @r4 = h
    f @r5 = free
    s @r0 = call mp3_hdr_samples(h)
    m @r6 = s
    a @r0 = hh
    k @r0 = call mp3_hdr_kbps(a)
    m = m * k
    t @r0 = 125
    m = m * t
    a @r0 = hh
    hz @r0 = call mp3_hdr_hz(a)
    n = m / hz
    l @r1 = hh[17..19]
    #(l - 3)
    if #eq {
        n &= !3
    }
    if n != 0 goto done
    n = f
done:
    pop(r4, r5, r6, pc)
}

// The frame size with padding
#[link_section = ".text"]
fn mp3_hdr_frame_size(h, free) -> n {
    push(r4, r5, r6, lr)
    hh @r4 = h
    b @r0 = call mp3_hdr_frame_bytes(h, free)
    fb @r5 = b
    a @r0 = hh
    p @r0 = call mp3_hdr_padding(a)
    n = fb + p
    pop(r4, r5, r6, pc)
}

// Whether the frames from mp3, with frame_bytes for free format, are
// followed by more of the same stream: up to MAX_FRAME_SYNC_MATCHES of
// them, or at least one before the end of the data
#[link_section = ".text"]
fn mp3_match_frame(mp3: *u8, len, frame_bytes) -> ok {
    push(r4, r5, r6, r7, r8, lr)
    q @r4 = mp3
    end @r8 = mp3 + len
    fb @r6 = frame_bytes
    h0 @r7 = *(mp3 as *u32)
    h0 = rev(h0)
    nmatch @r5 = 0
    loop {
        h @r0 = *(q as *u32)
        h = rev(h)
        f @r1 = fb
        s @r0 = call mp3_hdr_frame_size(h, f)
        q += s
        t @r0 = q + HDR_SIZE
        #(t - end)
        if #hi goto out
        o @r1 = *(q as *u32)
        o = rev(o)
        a @r0 = h0
        ok = call mp3_hdr_compare(a, o)
        if ok == 0 goto done
        nmatch += 1
        #(nmatch - MAX_FRAME_SYNC_MATCHES)
        if #ne goto loop
    }
    ok = 1
    goto done
out:
    ok = nmatch
    if ok == 0 goto done
    ok = 1
done:
    pop(r4, r5, r6, r7, r8, pc)
}

// Find the first frame in mp3, setting *ffb to its free format frame size
// if it's free format. Returns its offset and size, or len and 0.
#[link_section = ".text"]
fn mp3_find_frame(mp3: *u8, len, ffb: *u32) -> (ix, size) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    sp -= 12 (pad, other, fb2)
    base @r9 = mp3
    n @r8 = len
    ffp @r6 = ffb
    i @r7 = 0
    loop {
        t @r0 = i + HDR_SIZE
        #(t - n)
        if #hs goto break
        hp @r0 = base + i
        h @r5 = *(hp as *u32)
        h = rev(h)
        a @r0 = h
        ok @r0 = call mp3_hdr_valid(a)
        #(ok - 0)
        if #eq goto next
        a @r0 = h
        f @r1 = *ffp
        b @r0 = call mp3_hdr_frame_bytes(a, f)
        fb @r4 = b
        a @r0 = h
        p @r0 = call mp3_hdr_padding(a)
        sp.pad = p
        fap @r10 = fb + p
        if {
            #(fb - 0)
            if #ne goto end
            // Free format: look for the next frame of the stream
            k @r11 = HDR_SIZE
            loop {
                t @r0 = i + (k << 1)
                t += HDR_SIZE
                #(t - n)
                if #hs goto break
                hp @r1 = base + i
                hp += k
                o @r1 = *(hp as *u32)
                o = rev(o)
                sp.other = o
                a @r0 = h
                ok @r0 = call mp3_hdr_compare(a, o)
                if ok == 0 goto next_k
                p @r0 = sp.pad
                b2 @r0 = k - p
                sp.fb2 = b2
                o @r0 = sp.other
                po @r0 = call mp3_hdr_padding(o)
                b2 @r1 = sp.fb2
                nextfb @r0 = b2 + po
                // and the frame after it
                t @r1 = i + k
                t += nextfb
                e @r2 = t + HDR_SIZE
                #(e - n)
                if #hi goto next_k
                hp @r1 = base + t
                o2 @r1 = *(hp as *u32)
                o2 = rev(o2)
                a @r0 = h
                ok @r0 = call mp3_hdr_compare(a, o2)
                if ok == 0 goto next_k
                fap = k
                fb = sp.fb2
                *ffp = fb
                #(fb - 0)
                if #ne goto break
next_k:
                k += 1
                #(k - MAX_FREE_FORMAT_FRAME_SIZE)
                if #lo goto loop
            }
        }
        if {
            #(fb - 0)
            if #eq goto end
            t @r0 = i + fap
            #(t - n)
            if #hi goto end
            a @r0 = base + i
            l @r1 = n - i
            f @r2 = fb
            ok @r0 = call mp3_match_frame(a, l, f)
            if ok != 0 goto found
        }
        // or the data is exactly one frame
        if i != 0 goto reset
        #(fap - n)
        if #eq goto found
reset:
        z @r0 = 0
        *ffp = z
next:
        i += 1
        goto loop
    }
    ix = n
    size = 0
    goto done
found:
    ix = i
    size = fap
done:
    sp += 12
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// Read n bits, up to 24, or 0 past the limit. Reads the 4 bytes from the
// first bit's, which may be up to 3 past the last bit.
#[link_section = ".text"]
fn mp3_bs_get_bits(bs: *Mp3Bs, n) -> v {
    pos @r12 = bs.pos
    lim @r3 = bs.limit
    np @r2 = pos + n
    bs.pos = np
    #(np - lim)
    if #hi goto zero
    p @r3 = bs.buf
    ix @r2 = pos >> 3
    w @r2 = *((p + ix) as *u32)
    s @r3 = pos & 7
    w = rev(w)
    w <<= s
    t @r3 = 32 - n
    v = w >> t
    bx lr
zero:
    v = 0
    bx lr
}

// Decode a frame; see the top of the file
#[link_section = ".text"]
fn mp3_decode_frame(mp3: *u8, len, pcm: *i16, info: *Mp3Info) -> n {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    sp -= 12 (bsf: Mp3Bs)
    src @r8 = mp3
    n_src @r9 = len
    out @r6 = pcm
    inf @r7 = info
    dec @r4 = &mp3_decoder
    size @r5 = 0
    // If this continues the last frame's stream, it should start with a
    // frame, followed by the next one's header
    if {
        #(n_src - HDR_SIZE)
        if #ls goto end
        old @r0 = dec.header
        t @r1 = old >> 24
        #(t - 0xff)
        if #ne goto end
        h @r1 = *(src as *u32)
        h = rev(h)
        hh @r10 = h
        ok @r0 = call mp3_hdr_compare(old, h)
        if ok == 0 goto end
        a @r0 = hh
        f @r1 = dec.free_format_bytes
        s @r0 = call mp3_hdr_frame_size(a, f)
        size = s
        #(size - n_src)
        if #eq goto end
        t @r0 = size + HDR_SIZE
        #(t - n_src)
        if #hi goto mismatch
        p @r1 = src + size
        o @r1 = *(p as *u32)
        o = rev(o)
        a @r0 = hh
        ok @r0 = call mp3_hdr_compare(a, o)
        if ok != 0 goto end
mismatch:
        size = 0
    }
    ix @r10 = 0
    if {
        #(size - 0)
        if #ne goto end
        call mp3_init()
        a @r0 = src
        l @r1 = n_src
        ffb @r2 = &dec.free_format_bytes
        (i @r0, s @r1) = call mp3_find_frame(a, l, ffb)
        ix = i
        size = s
        #(s - 0)
        if #eq goto no_frame
        t @r0 = i + s
        #(t - n_src)
        if #hi goto no_frame
    }
    hp @r0 = src + ix
    h @r11 = *(hp as *u32)
    h = rev(h)
    dec.header = h
    t @r0 = ix + size
    inf.frame_bytes = t
    inf.frame_offset = ix
    ch @r0 = 2
    t @r1 = h & HDR_MODE
    #(t - HDR_MODE)
    if #eq {
        ch = 1
    }
    inf.channels = ch
    a @r0 = h
    hz @r0 = call mp3_hdr_hz(a)
    inf.hz = hz
    l @r0 = h[17..19]
    l = 4 - l
    inf.layer = l
    a @r0 = h
    k @r0 = call mp3_hdr_kbps(a)
    inf.bitrate_kbps = k
    if {
        if out != 0 goto end
        a @r0 = h
        n = call mp3_hdr_samples(a)
        goto done
    }
    #(size - HDR_SIZE)
    if #lo goto bad
    buf @r0 = src + ix
    buf += HDR_SIZE
    sp.bsf.buf = buf
    zero @r0 = 0
    sp.bsf.pos = zero
    lim @r0 = size - HDR_SIZE
    lim <<= 3
    sp.bsf.limit = lim
    if {
        #(h & HDR_CRC_ABSENT)
        if #ne goto end
        b @r0 = &sp.bsf
        w @r1 = 16
        call mp3_bs_get_bits(b, w)
    }
    p @r0 = &mp3_scratch.gr_info as *u32
    c @r1 = SCRATCH_CLEAR_WORDS
    call mp3_zero(p, c)
    // only layer 3 is decoded
    l @r0 = h[17..19]
    #(l - 1)
    if #ne goto not_l3
    b @r0 = &sp.bsf
    a @r1 = h
    mdb @r0 = call mp3_read_side_info(b, a)
    #(mdb - L3_ERROR)
    if #eq goto bad
    pos @r1 = sp.bsf.pos
    lim @r2 = sp.bsf.limit
    #(pos - lim)
    if #hi goto bad
    m @r1 = mdb
    b @r0 = &sp.bsf
    ok @r0 = call mp3_restore_reservoir(b, m)
    success @r5 = ok
    if {
        if ok == 0 goto end
        nch @r7 = inf.channels
        // the granule index, times channels
        gi @r9 = 0
        ngr @r10 = 1
        #(h & HDR_MPEG1)
        if #ne {
            ngr = 2
        }
        loop {
            p @r0 = &mp3_scratch.grbuf as *u32
            c @r1 = 1152
            call mp3_zero(p, c)
            a @r0 = gi
            b @r1 = nch
            call mp3_l3_decode(a, b)
            b @r0 = nch
            o @r1 = out
            call mp3_synth_granule(b, o)
            t @r0 = nch << 10
            t = t + (nch << 7)
            out += t
            gi += nch
            #(ngr -= 1)
            if #ne goto loop
        }
    }
    call mp3_save_reservoir()
    a @r0 = h
    s @r0 = call mp3_hdr_samples(a)
    n = s * success
    goto done
no_frame:
    inf.frame_bytes = ix
    n = 0
    goto done
bad:
    old @r0 = dec.header
    old &= 0x00ffffff
    dec.header = old
not_l3:
    n = 0
done:
    sp += 12
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// Put the reservoir and then the frame's main data, from bs, in
// mp3_scratch.maindata, and start mp3_scratch.bs on it. Returns whether
// the reservoir had all main_data_begin bytes.
#[link_section = ".text"]
fn mp3_restore_reservoir(bs: *Mp3Bs, main_data_begin) -> ok {
    push(r4, r5, r6, r7, r8, r9, r10, lr)
    b @r4 = bs
    mdb @r8 = main_data_begin
    dec @r6 = &mp3_decoder
    s @r7 = &mp3_scratch
    pos @r0 = b.pos
    lim @r1 = b.limit
    fbytes @r5 = lim - pos
    fbytes >>= 3
    res @r2 = dec.reserv
    have @r9 = res
    #(have - mdb)
    if #hi {
        have = mdb
    }
    d @r0 = &mp3_scratch.maindata as *u8
    src @r1 = &dec.reserv_buf as *u8
    src += res
    src -= have
    cnt @r2 = have
    call mp3_copy(d, src, cnt)
    d @r0 = &mp3_scratch.maindata as *u8
    d += have
    buf @r1 = b.buf
    pos @r2 = b.pos
    src @r1 = buf + (pos >> 3)
    cnt @r2 = fbytes
    call mp3_copy(d, src, cnt)
    total @r3 = have + fbytes
    md @r0 = &mp3_scratch.maindata as *u8
    s.bs.buf = md
    zero @r1 = 0
    s.bs.pos = zero
    bits @r1 = total << 3
    s.bs.limit = bits
    // zero what's left of the last frame's main data
    dirty @r2 = s.dirty
    s.dirty = total
    if {
        #(dirty - total)
        if #ls goto end
        d @r0 = md + total
        z @r1 = 0
        n @r2 = dirty - total
        loop {
            *d++ = z
            #(n -= 1)
            if #ne goto loop
        }
    }
    r @r1 = dec.reserv
    ok = 0
    #(r - mdb)
    if #hs {
        ok = 1
    }
    pop(r4, r5, r6, r7, r8, r9, r10, pc)
}

// Keep the end of the main data, up to MAX_BITRESERVOIR_BYTES, for the
// next frame
#[link_section = ".text"]
fn mp3_save_reservoir() {
    push(r4, lr)
    s @r3 = &mp3_scratch
    pos @r1 = s.bs.pos
    pos += 7
    pos >>= 3
    lim @r2 = s.bs.limit
    rem @r2 = lim >> 3
    rem -= pos
    mx @r12 = MAX_BITRESERVOIR_BYTES
    #(rem - mx)
    if #hi {
        pos += rem
        pos -= mx
        rem = mx
    }
    dec @r4 = &mp3_decoder
    dec.reserv = rem
    d @r0 = &dec.reserv_buf as *u8
    md @r3 = &mp3_scratch.maindata as *u8
    src @r1 = md + pos
    cnt @r2 = rem
    call mp3_copy(d, src, cnt)
    pop(r4, pc)
}

// Read the side information into mp3_scratch.gr_info. Returns
// main_data_begin, or L3_ERROR.
#[link_section = ".text"]
fn mp3_read_side_info(bs: *Mp3Bs, h) -> mdb {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    sp -= 4 (tables)
    b @r6 = bs
    hh @r10 = h
    gr @r5 = &mp3_scratch.gr_info as *Mp3Gr
    // the sample rate index, mpeg1 ones last, less 1 but at least 0
    sr @r4 = h[10..12]
    t @r0 = h[19..20]
    t2 @r1 = h[20..21]
    t += t2
    t = t + (t << 1)
    sr += t
    #(sr - 0)
    if #ne {
        sr -= 1
    }
    // the granules to read, 2 per channel for MPEG-1
    cnt @r9 = 2
    t = hh & HDR_MODE
    #(t - HDR_MODE)
    if #eq {
        cnt = 1
    }
    scfsi @r7 = 0
    if {
        #(hh & HDR_MPEG1)
        if #eq goto else
        cnt <<= 1
        a @r0 = b
        w @r1 = 9
        v @r0 = call mp3_bs_get_bits(a, w)
        m @r11 = v
        a @r0 = b
        w @r1 = cnt + 7
        v @r0 = call mp3_bs_get_bits(a, w)
        scfsi = v
        goto end
    } else {
        a @r0 = b
        w @r1 = cnt + 8
        v @r0 = call mp3_bs_get_bits(a, w)
        m @r11 = v >> cnt
    }
    sum @r8 = 0
    loop {
        t @r0 = hh & HDR_MODE
        #(t - HDR_MODE)
        if #eq {
            scfsi <<= 4
        }
        a @r0 = b
        w @r1 = 12
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.part_23_length = v
        sum += v
        a @r0 = b
        w @r1 = 9
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.big_values = v
        #(v - 288)
        if #hi goto error
        a @r0 = b
        w @r1 = 8
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.global_gain = v
        a @r0 = b
        w @r1 = 9
        #(hh & HDR_MPEG1)
        if #ne {
            w = 4
        }
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.scalefac_compress = v
        tab @r0 = &mp3_scf_long as *u8
        off @r1 = sr + (sr << 1)
        off <<= 3
        off -= sr
        tab += off
        gr.sfbtab = tab
        nl @r0 = 22
        gr.n_long_sfb = nl
        zero @r0 = 0
        gr.n_short_sfb = zero
        a @r0 = b
        w @r1 = 1
        v @r0 = call mp3_bs_get_bits(a, w)
        if {
            #(v - 0)
            if #eq goto else
            a @r0 = b
            w @r1 = 2
            bt @r0 = call mp3_bs_get_bits(a, w)
            #(bt - 0)
            if #eq goto error
            gr.block_type = bt
            a @r0 = b
            w @r1 = 1
            mixed @r0 = call mp3_bs_get_bits(a, w)
            gr.mixed_block_flag = mixed
            rc @r1 = &gr.region_count as *u8
            seven @r2 = 7
            *rc = seven
            all @r2 = 255
            *(rc + 1) = all
            if {
                bt @r2 = gr.block_type
                #(bt - SHORT_BLOCK_TYPE)
                if #ne goto end
                mk @r2 = 0xf0f
                scfsi &= mk
                off @r2 = sr << 3
                off = off + (off << 2)
                if {
                    if mixed != 0 goto else
                    eight @r0 = 8
                    *rc = eight
                    tab @r0 = &mp3_scf_short as *u8
                    tab += off
                    gr.sfbtab = tab
                    zero @r0 = 0
                    gr.n_long_sfb = zero
                    ns @r0 = 39
                    gr.n_short_sfb = ns
                    goto end
                } else {
                    tab @r0 = &mp3_scf_mixed as *u8
                    tab += off
                    gr.sfbtab = tab
                    nl @r0 = 6
                    #(hh & HDR_MPEG1)
                    if #ne {
                        nl = 8
                    }
                    gr.n_long_sfb = nl
                    ns @r0 = 30
                    gr.n_short_sfb = ns
                }
            }
            a @r0 = b
            w @r1 = 10
            v @r0 = call mp3_bs_get_bits(a, w)
            v <<= 5
            sp.tables = v
            a @r0 = b
            w @r1 = 3
            v @r0 = call mp3_bs_get_bits(a, w)
            sg @r1 = &gr.subblock_gain as *u8
            *sg = v
            a @r0 = b
            w @r1 = 3
            v @r0 = call mp3_bs_get_bits(a, w)
            sg @r1 = &gr.subblock_gain as *u8
            *(sg + 1) = v
            a @r0 = b
            w @r1 = 3
            v @r0 = call mp3_bs_get_bits(a, w)
            sg @r1 = &gr.subblock_gain as *u8
            *(sg + 2) = v
            goto end
        } else {
            zero @r0 = 0
            gr.block_type = zero
            gr.mixed_block_flag = zero
            a @r0 = b
            w @r1 = 15
            v @r0 = call mp3_bs_get_bits(a, w)
            sp.tables = v
            a @r0 = b
            w @r1 = 4
            v @r0 = call mp3_bs_get_bits(a, w)
            rc @r1 = &gr.region_count as *u8
            *rc = v
            a @r0 = b
            w @r1 = 3
            v @r0 = call mp3_bs_get_bits(a, w)
            rc @r1 = &gr.region_count as *u8
            *(rc + 1) = v
            all @r0 = 255
            *(rc + 2) = all
        }
        tables @r0 = sp.tables
        ts @r1 = &gr.table_select as *u8
        t @r2 = tables >> 10
        *ts = t
        t = tables[5..10]
        *(ts + 1) = t
        t = tables & 31
        *(ts + 2) = t
        if {
            #(hh & HDR_MPEG1)
            if #eq goto else
            a @r0 = b
            w @r1 = 1
            v @r0 = call mp3_bs_get_bits(a, w)
            gr.preflag = v
            goto end
        } else {
            c @r0 = gr.scalefac_compress
            p @r1 = 0
            #(c - 500)
            if #hs {
                p = 1
            }
            gr.preflag = p
        }
        a @r0 = b
        w @r1 = 1
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.scalefac_scale = v
        a @r0 = b
        w @r1 = 1
        v @r0 = call mp3_bs_get_bits(a, w)
        gr.count1_table = v
        t @r0 = scfsi[12..16]
        gr.scfsi = t
        scfsi <<= 4
        gr += size(Mp3Gr)
        #(cnt -= 1)
        if #ne goto loop
    }
    // all the granules' bits must be in this frame and the reservoir
    pos @r0 = b.pos
    sum += pos
    lim @r0 = b.limit
    lim += m << 3
    #(sum - lim)
    if #hi goto error
    mdb = m
    goto done
error:
    mdb = L3_ERROR
done:
    sp += 4
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// y * 2^(-exp_q2 / 4), for exp_q2 at least 0
#[link_section = ".text"]
fn mp3_ldexp_q2(y: f32, exp_q2: i32) -> r: f32 {
    e @r0 = exp_q2
    while {
        #(e - 120)
        if #lt goto break
    } loop {
        k @s1 = 9.313225746154785e-10
        y = y * k
        e -= 120
        #(e - 120)
        if #ge goto loop
    }
    t @r1 = &mp3_expfrac as *f32
    f3 @r2 = e & 3
    a @r1 = t + (f3 << 2)
    f @s1 = *a
    y = y * f
    sh @r2 = e >> 2
    p @r3 = 1 << 30
    p >>= sh
    ps @s1 = p
    pf @s1 = u32_to_f32(ps)
    r = y * pf
    bx lr
}

// Read the scalefactors of granule gr, channel ch, into mp3_scratch.scf,
// and the intensity stereo positions into ist
#[link_section = ".text"]
fn mp3_decode_scalefactors(gr: *Mp3Gr, ist: *u8, ch) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    push(s16)
    sp -= 48 (iscf: [u8; 40], sizes: [u8; 4], pad)
    g @r4 = gr
    ip @r8 = ist
    d @r9 = &mp3_decoder
    hh @r9 = d.header
    c @r7 = ch
    // iscf = 0
    z @r0 = 0
    z1 @r1 = 0
    z2 @r2 = 0
    z3 @r12 = 0
    p @r3 = &sp.iscf as *u32
    *p++ = (z, z1, z2, z3)
    *p++ = (z, z1, z2, z3)
    *p++ = (z, z1)
    // the partition table
    ns @r0 = g.n_short_sfb
    nl @r1 = g.n_long_sfb
    k @r2 = 0
    #(ns - 0)
    if #ne {
        k = 1
    }
    #(nl - 0)
    if #eq {
        k += 1
    }
    part @r10 = &mp3_scf_partitions as *u8
    t @r12 = k << 5
    t -= k << 2
    part += t
    scfsi @r6 = g.scfsi
    if {
        #(hh & HDR_MPEG1)
        if #eq goto else
        sc @r0 = g.scalefac_compress
        tab @r1 = &mp3_scfc_decode as *u8
        pv @r0 = *(tab + sc)
        hi @r1 = pv >> 2
        lo @r2 = pv & 3
        both @r1 = hi | (hi << 8)
        both |= lo << 16
        both |= lo << 24
        szw @r0 = &sp.sizes as *u32
        *szw = both
        goto end
    } else {
        sfc @r0 = g.scalefac_compress
        mp @r1 = &mp3_mod as *u8
        if {
            #(hh & HDR_I_STEREO)
            if #eq goto end
            if c == 0 goto end
            sfc >>= 1
            mp += 12
        }
        mods @r5 = mp
        szp @r7 = &sp.sizes as *u8
        // the sizes, from the last, as digits of sfc in the bases from
        // mp3_mod, until it goes negative
        while {
            #(sfc - 0)
            if #lt goto break
        } loop {
            prod @r2 = 1
            g3 @r12 = *(mods + 3)
            q @r3 = sfc / prod
            q2 @r11 = q / g3
            q = q - q2 * g3
            *(szp + 3) = q
            prod = prod * g3
            g3 = *(mods + 2)
            q = sfc / prod
            q2 = q / g3
            q = q - q2 * g3
            *(szp + 2) = q
            prod = prod * g3
            g3 = *(mods + 1)
            q = sfc / prod
            q2 = q / g3
            q = q - q2 * g3
            *(szp + 1) = q
            prod = prod * g3
            g3 = *mods
            q = sfc / prod
            q2 = q / g3
            q = q - q2 * g3
            *(szp + 0) = q
            prod = prod * g3
            sfc -= prod
            mods += 4
            #(sfc - 0)
            if #ge goto loop
        }
        mp @r1 = &mp3_mod as *u8
        k @r2 = mods - mp
        part += k
        scfsi = -16
    }
    // read_scalefactors: up to 4 partitions, of count scalefactors of
    // sizes[i] bits each. A partition with its scfsi bit set (bit 3 of
    // this) reuses the last granule's, which ist holds.
    this @r6 = scfsi
    dp @r9 = &sp.iscf as *u8
    sz @r7 = &sp.sizes as *u8
    i @r5 = 4
    loop {
        cnt @r11 = *part++
        #(cnt - 0)
        if #eq goto break
        if {
            #(this & 8)
            if #eq goto else
            loop {
                v @r0 = *ip++
                *dp++ = v
                #(cnt -= 1)
                if #ne goto loop
            }
            goto end
        } else {
            bits @r1 = *sz
            if {
                if bits != 0 goto else
                z @r0 = 0
                loop {
                    *dp++ = z
                    *ip++ = z
                    #(cnt -= 1)
                    if #ne goto loop
                }
                goto end
            } else {
                loop {
                    a @r0 = &mp3_scratch.bs
                    w @r1 = *sz
                    v @r0 = call mp3_bs_get_bits(a, w)
                    *dp++ = v
                    if {
                        // the largest value is an illegal position
                        #(this - 0)
                        if #pl goto end
                        w @r1 = *sz
                        t @r2 = v + 1
                        t >>= w
                        #(t - 1)
                        if #ne goto end
                        v = 255
                    }
                    *ip++ = v
                    #(cnt -= 1)
                    if #ne goto loop
                }
            }
        }
        this <<= 1
        sz += 1
        #(i -= 1)
        if #ne goto loop
    }
    // subblock gain or preemphasis
    ns @r0 = g.n_short_sfb
    if {
        if ns == 0 goto else
        sh @r1 = g.scalefac_scale
        sh = 2 - sh
        sgp @r2 = &g.subblock_gain as *u8
        sg0 @r12 = *sgp
        sg0 <<= sh
        sg1 @r3 = *(sgp + 1)
        sg1 <<= sh
        sg2 @lr = *(sgp + 2)
        sg2 <<= sh
        nl @r1 = g.n_long_sfb
        isp @r2 = &sp.iscf as *u8
        isp += nl
        loop {
            x @r1 = *isp
            x += sg0
            *isp = x
            x = *(isp + 1)
            x += sg1
            *(isp + 1) = x
            x = *(isp + 2)
            x += sg2
            *(isp + 2) = x
            isp += 3
            #(ns -= 3)
            if #hi goto loop
        }
        goto end
    } else {
        pf @r1 = g.preflag
        if pf == 0 goto end
        isp @r2 = &sp.iscf as *u8
        isp += 11
        pre @r12 = &mp3_preamp as *u8
        n @r3 = 10
        loop {
            x @r1 = *isp
            y @r0 = *pre++
            x += y
            *isp++ = x
            #(n -= 1)
            if #ne goto loop
        }
    }
    // the global gain, then each scalefactor
    gg @r0 = g.global_gain
    d @r1 = &mp3_decoder
    hh @r1 = d.header
    hh &= 0xe0
    e @r2 = 44 + 214
    #(hh - HDR_JOINT_MS)
    if #eq {
        e += 2
    }
    e -= gg
    ex @r0 = e
    big @s0 = 2048.0
    gain @s0 = call mp3_ldexp_q2(big, ex)
    keep @s16 = gain
    shift @r7 = g.scalefac_scale
    shift += 1
    n @r5 = g.n_long_sfb
    ns @r0 = g.n_short_sfb
    n += ns
    isp @r9 = &sp.iscf as *u8
    out @r6 = &mp3_scratch.scf as *f32
    loop {
        x @r0 = *isp++
        x <<= shift
        yf @s0 = keep
        r @s0 = call mp3_ldexp_q2(yf, x)
        *out++ = r
        #(n -= 1)
        if #ne goto loop
    }
    sp += 48
    pop(s16)
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// Decode the Huffman coded values of granule gr, which end at the bit
// position limit, into dst, scaled by mp3_scratch.scf
#[link_section = ".ram"]
fn mp3_huffman(dst: *f32, gr: *Mp3Gr, limit) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    push(s16)
    sp -= 16 (ireg: *u8, bands, lim, c1)
    sp.lim = limit
    big @r6 = gr.big_values
    sfb @r10 = gr.sfbtab
    c1t @r2 = gr.count1_table
    sp.c1 = c1t
    ts @r2 = &gr.table_select as *u8
    sp.ireg = ts
    scf @r8 = &mp3_scratch.scf as *f32
    // the bit cache: the next bits, left aligned. shift is the number of
    // bits used of those loaded, less 8, at most -1 after a refill.
    bsp @r2 = &mp3_scratch.bs
    pos @r4 = bsp.pos
    ptr @r9 = bsp.buf
    t @r2 = pos >> 3
    ptr += t
    cache @r3 = *(ptr as *u32)
    cache = rev(cache)
    ptr += 4
    t = pos & 7
    cache <<= t
    shift @r4 = t - 8
    pow @lr = &mp3_pow43 as *f32
    pow += 16 * 4
    z @r2 = 0
    one @s16 = from_bits(z)
    // big values, in up to 3 regions of bands, each with its table
    while {
        #(big - 0)
        if #le goto break
    } loop {
        ts @r2 = sp.ireg
        tab @r5 = *ts
        nb @r1 = *(ts + 3)
        ts += 1
        sp.ireg = ts
        nb += 1
        sp.bands = nb
        hi @r2 = &mp3_huff_index as *u16
        off @r2 = *(hi + tab * 2)
        cb @r12 = &mp3_huff_tabs as *i16
        cb = cb + (off << 1)
        lb @r2 = &mp3_linbits as *u8
        linbits @r7 = *(lb + tab)
        if {
            #(linbits - 0)
            if #ne goto else
            loop {
                np @r5 = *sfb++
                np >>= 1
                pairs @r11 = big
                #(pairs - np)
                if #gt {
                    pairs = np
                }
                // each pair's first lookup is at the end of the one before
                t @r2 = cache >> 27
                leaf @r1 = *(cb + t * 2)
                one = *scf++
                big -= np
                #(pairs - 0)
                if #le goto band_done
                loop {
                    // a longer code needs more lookups, after the loop
                    #(leaf - 0)
                    if #lt goto long_code
                have_leaf:
                    t = leaf >> 8
                    cache <<= t
                    shift += t
                    // two values, the first in the low 4 bits, each with a
                    // sign bit after it when it's nonzero. linbits is 0
                    // here, so its register is free.
                    lsb @r2 = leaf & 15
                    lsb2 @r7 = (leaf as u32)[4..8]
                    m @r5 = (cache as i32) >> 31
                    m = lsb + (m << 4)
                    #(lsb - 0)
                    if #ne {
                        cache <<= 1
                        shift += 1
                    }
                    a @r5 = pow + (m << 2)
                    m2 @r1 = (cache as i32) >> 31
                    v @s0 = *a
                    m2 = lsb2 + (m2 << 4)
                    v = v * one
                    #(lsb2 - 0)
                    if #ne {
                        cache <<= 1
                        shift += 1
                    }
                    a2 @r5 = pow + (m2 << 2)
                    *dst++ = v
                    v2 @s1 = *a2
                    v2 = v2 * one
                    while {
                        #(shift - 0)
                        if #lt goto break
                    } loop {
                        b @r2 = *ptr++
                        b <<= shift
                        cache |= b
                        #(shift -= 8)
                        if #ge goto loop
                    }
                    t @r2 = cache >> 27
                    leaf @r1 = *(cb + t * 2)
                    *dst++ = v2
                    #(pairs -= 1)
                    if #ne goto loop
                }
band_done:
                #(big - 0)
                if #le goto break
                nb @r1 = sp.bands
                #(nb -= 1)
                sp.bands = nb
                if #ne goto loop
            }
            goto end
        } else {
            loop {
                np @r5 = *sfb++
                np >>= 1
                pairs @r11 = big
                #(pairs - np)
                if #gt {
                    pairs = np
                }
                one = *scf++
                big -= np
                #(pairs - 0)
                if #le goto lin_band_done
                loop {
                    t @r2 = cache >> 27
                    leaf @r1 = *(cb + t * 2)
                    w @r5 = 5
                    while {
                        #(leaf - 0)
                        if #ge goto break
                    } loop {
                        cache <<= w
                        shift += w
                        w = leaf & 7
                        t = 32 - w
                        t = cache >> t
                        t -= (leaf as i32) >> 3
                        leaf = *(cb + t * 2)
                        #(leaf - 0)
                        if #lt goto loop
                    }
                    t = leaf >> 8
                    // the two values, the first in the low 4 bits; a bit
                    // above them ends the loop
                    leaf = (leaf as u32)[0..8]
                    leaf |= 256
                    cache <<= t
                    shift += t
                    loop {
                        lsb @r2 = leaf & 15
                        // l3_pow_43 of 15 plus linbits more bits, then the sign
                        if {
                            #(lsb - 15)
                            if #ne goto else
                            t @r5 = 32 - linbits
                            x @r2 = cache >> t
                            x += 15
                            cache <<= linbits
                            shift += linbits
                            while {
                                #(shift - 0)
                                if #lt goto break
                            } loop {
                                b @r5 = *ptr++
                                b <<= shift
                                cache |= b
                                #(shift -= 8)
                                if #ge goto loop
                            }
                            if {
                                #(x - 129)
                                if #hs goto else
                                a @r5 = pow + (x << 2)
                                v @s0 = *a
                                goto end
                            } else {
                                k @r5 = &mp3_pow43_k as *f32
                                (c16 @s1, c256 @s2, c43 @s3, c29 @s4) = *k
                                mult @s5 = c256
                                #(x - 1024)
                                if #lo {
                                    mult = c16
                                    x <<= 3
                                }
                                sign @r5 = x << 1
                                sign &= 64
                                nu @lr = x & 63
                                nu -= sign
                                ni @s6 = nu
                                fnu @s6 = i32_to_f32(ni)
                                de @lr = x & !63
                                de += sign
                                di @s7 = de
                                fde @s7 = i32_to_f32(di)
                                x += sign
                                x >>= 6
                                frac @s6 = fnu / fde
                                sc @s7 = c43
                                sc += frac * c29
                                sc2 @s8 = 1.0
                                sc2 += frac * sc
                                sc2 = sc2 * mult
                                pow @lr = &mp3_pow43 as *f32
                                pow += 16 * 4
                                a @r5 = pow + (x << 2)
                                v @s0 = *a
                                v = v * sc2
                            }
                            v = one * v
                            #(cache - 0)
                            if #mi {
                                v = -v
                            }
                            *dst++ = v
                            cache <<= 1
                            shift += 1
                            leaf >>= 4
                            goto end
                        } else {
                            m @r5 = (cache as i32) >> 31
                            m = lsb + (m << 4)
                            #(lsb - 0)
                            if #ne {
                                cache <<= 1
                                shift += 1
                            }
                            a @r5 = pow + (m << 2)
                            leaf >>= 4
                            v @s0 = *a
                            v = v * one
                            *dst++ = v
                        }
                        #(leaf - 16)
                        if #hs goto loop
                    }
                    while {
                        #(shift - 0)
                        if #lt goto break
                    } loop {
                        b @r2 = *ptr++
                        b <<= shift
                        cache |= b
                        #(shift -= 8)
                        if #ge goto loop
                    }
                    #(pairs -= 1)
                    if #ne goto loop
                }
lin_band_done:
                #(big - 0)
                if #le goto break
                nb @r1 = sp.bands
                #(nb -= 1)
                sp.bands = nb
                if #ne goto loop
            }
        }
        #(big - 0)
        if #gt goto loop
    }
    // the count1 region, values of 0 or 1 in quads, until the limit
    np @r6 = 1 - big
    cb1 @r12 = &mp3_tab32 as *u8
    c1 @r5 = sp.c1
    #(c1 - 0)
    if #eq goto tab32
    cb1 = &mp3_tab33 as *u8
tab32:
    lim24 @r7 = sp.lim
    lim24 += 24
    base @r11 = &mp3_scratch.maindata as *u8
    // each value is one with the sign bit after it, so as bits
    onebits @r5 = to_bits(one)
    loop {
        t @r2 = cache >> 28
        leaf @r1 = *(cb1 + t)
        pb @lr = ptr - base
        if {
            #(leaf & 8)
            if #ne goto end
            t = cache << 4
            w @lr = leaf & 3
            w = 32 - w
            t >>= w
            t += leaf >> 3
            leaf = *(cb1 + t)
            pb @lr = ptr - base
        }
        t = leaf & 7
        cache <<= t
        shift += t
        // stop past the limit
        t = shift + (pb << 3)
        #(t - lim24)
        if #hi goto count1_done
        // a new band, with a new scale, after the loop
        #(np -= 1)
        if #eq goto band0
have0:
        if {
            #(leaf & 128)
            if #eq goto end
            sg @r2 = cache & 0x80000000
            sg ^= onebits
            *(dst as *u32) = sg
            cache <<= 1
            shift += 1
        }
        if {
            #(leaf & 64)
            if #eq goto end
            sg @r2 = cache & 0x80000000
            sg ^= onebits
            *((dst + 4) as *u32) = sg
            cache <<= 1
            shift += 1
        }
        #(np -= 1)
        if #eq goto band1
have1:
        if {
            #(leaf & 32)
            if #eq goto end
            sg @r2 = cache & 0x80000000
            sg ^= onebits
            *((dst + 8) as *u32) = sg
            cache <<= 1
            shift += 1
        }
        if {
            #(leaf & 16)
            if #eq goto end
            sg @r2 = cache & 0x80000000
            sg ^= onebits
            *((dst + 12) as *u32) = sg
            cache <<= 1
            shift += 1
        }
        while {
            #(shift - 0)
            if #lt goto break
        } loop {
            b @r2 = *ptr++
            b <<= shift
            cache |= b
            #(shift -= 8)
            if #ge goto loop
        }
        dst += 16
        goto loop
    }
count1_done:
    bsp @r0 = &mp3_scratch.bs
    lim @r1 = sp.lim
    bsp.pos = lim
    sp += 16
    pop(s16)
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
    // The rest of a code longer than 5 bits, for the pair loop above: each
    // negative leaf gives the next lookup's width and offset.
long_code:
    w @r5 = 5
    loop {
        cache <<= w
        shift += w
        w = leaf & 7
        t = 32 - w
        t = cache >> t
        t -= (leaf as i32) >> 3
        leaf = *(cb + t * 2)
        #(leaf - 0)
        if #lt goto loop
    }
    goto have_leaf
    // The next band in the count1 region, before its first or third value
band0:
    np = *sfb++
    #(np >>= 1)
    if #eq goto count1_done
    one = *scf++
    onebits = to_bits(one)
    goto have0
band1:
    np = *sfb++
    #(np >>= 1)
    if #eq goto count1_done
    one = *scf++
    onebits = to_bits(one)
    goto have1
}

// Decode granule gi (times nch) of all channels into mp3_scratch.grbuf,
// as frequency lines through the IMDCT
#[link_section = ".text"]
fn mp3_l3_decode(gi, nch) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    sp -= 4
    g0 @r9 = &mp3_scratch.gr_info as *Mp3Gr
    t @r2 = size(Mp3Gr)
    t = gi * t
    g0 += t
    n @r8 = nch
    // scalefactors and Huffman decoding
    gr @r4 = g0
    ist @r10 = &mp3_scratch.ist_pos as *u8
    gp @r11 = &mp3_scratch.grbuf as *f32
    ch @r7 = 0
    loop {
        bsp @r0 = &mp3_scratch.bs
        pos @r0 = bsp.pos
        len @r1 = gr.part_23_length
        lim @r5 = pos + len
        a @r0 = gr
        i @r1 = ist
        c @r2 = ch
        call mp3_decode_scalefactors(a, i, c)
        d @r0 = gp
        g @r1 = gr
        l @r2 = lim
        call mp3_huffman(d, g, l)
        gr += size(Mp3Gr)
        ist += 39
        gp += 576 * 4
        ch += 1
        #(ch - n)
        if #lo goto loop
    }
    // stereo
    dec @r0 = &mp3_decoder
    h @r10 = dec.header
    if {
        #(h & HDR_I_STEREO)
        if #eq goto else
        a @r0 = g0
        call mp3_intensity_stereo(a)
        goto end
    } else {
        t @r0 = h & 0xe0
        #(t - HDR_JOINT_MS)
        if #ne goto end
        l @r0 = &mp3_scratch.grbuf as *f32
        c @r1 = 576
        call mp3_ms_band(l, c)
    }
    // reorder, antialias, IMDCT
    gr = g0
    gp = &mp3_scratch.grbuf as *f32
    ov @r6 = &mp3_decoder.mdct_overlap as *f32
    ch = 0
    loop {
        // the long bands of a mixed block, 4 at 8 kHz
        nlb @r5 = 0
        if {
            m @r0 = gr.mixed_block_flag
            if m == 0 goto end
            nlb = 2
            v @r0 = h[19..21]
            if v != 0 goto end
            sr @r0 = h[10..12]
            #(sr - 2)
            if #eq {
                nlb = 4
            }
        }
        if {
            ns @r0 = gr.n_short_sfb
            if ns == 0 goto end
            t @r0 = nlb << 6
            t = t + (nlb << 3)
            g @r0 = gp + t
            nl @r1 = gr.n_long_sfb
            s @r2 = gr.sfbtab
            sfb @r1 = s + nl
            call mp3_reorder(g, sfb)
        }
        aa @r1 = 31
        if {
            ns @r0 = gr.n_short_sfb
            if ns == 0 goto end
            aa = nlb
            #(aa - 0)
            if #ne {
                aa -= 1
            }
        }
        g @r0 = gp
        call mp3_antialias(g, aa)
        g @r0 = gp
        o @r1 = ov
        bt @r2 = gr.block_type
        nl @r3 = nlb
        call mp3_imdct_gr(g, o, bt, nl)
        g @r0 = gp
        call mp3_change_sign(g)
        gr += size(Mp3Gr)
        gp += 576 * 4
        ov += 288 * 4
        ch += 1
        #(ch - n)
        if #lo goto loop
    }
    sp += 4
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// Mid/side stereo for n lines from l, and the right channel's
#[link_section = ".ram"]
fn mp3_ms_band(l: *f32, n) {
    r @r2 = l + 576 * 4
    loop {
        a @s0 = *l
        b @s1 = *r
        x @s2 = a + b
        y @s3 = a - b
        *l++ = x
        *r++ = y
        #(n -= 1)
        if #ne goto loop
    }
    bx lr
}

// Intensity stereo: both channels from the left, scaled
#[link_section = ".ram"]
fn mp3_is_band(l: *f32, n, kl: f32, kr: f32) {
    r @r2 = l + 576 * 4
    loop {
        a @s2 = *l
        x @s3 = a * kl
        y @s4 = a * kr
        *l++ = x
        *r++ = y
        #(n -= 1)
        if #ne goto loop
    }
    bx lr
}

// Intensity stereo for the granule whose left channel is gr
#[link_section = ".text"]
fn mp3_intensity_stereo(gr: *Mp3Gr) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    push(s16)
    sp -= 16 (max_band: [u32; 3], saved)
    g @r5 = gr
    // the last nonzero band of the right channel, per window
    m @r0 = -1
    mb @r1 = &sp.max_band as *u32
    *mb = m
    *(mb + 4) = m
    *(mb + 8) = m
    nl @r0 = g.n_long_sfb
    ns @r1 = g.n_short_sfb
    nsfb @r9 = nl + ns
    p @r8 = &mp3_scratch.grbuf as *u32
    p += 576 * 4
    sfb @r6 = g.sfbtab
    i @r7 = 0
    m3 @r4 = 0
    while {
        #(i - nsfb)
        if #hs goto break
    } loop {
        wd @r10 = *(sfb + i)
        q @r0 = p
        c @r1 = wd
        loop {
            x @r2 = *q++
            #(x <<= 1)
            if #ne goto nonzero
            #(c -= 1)
            if #ne goto loop
            goto next_band
        }
nonzero:
        mb @r0 = &sp.max_band as *u32
        *(mb + m3 * 4) = i
next_band:
        p = p + (wd << 2)
        i += 1
        m3 += 1
        #(m3 - 3)
        if #eq {
            m3 = 0
        }
        #(i - nsfb)
        if #lo goto loop
    }
    mb @r0 = &sp.max_band as *u32
    if {
        nl @r1 = g.n_long_sfb
        if nl == 0 goto end
        a @r1 = *mb
        b @r2 = *(mb + 4)
        #(a - b)
        if #lt {
            a = b
        }
        b = *(mb + 8)
        #(a - b)
        if #lt {
            a = b
        }
        *mb = a
        *(mb + 4) = a
        *(mb + 8) = a
    }
    d @r1 = &mp3_decoder
    h @r10 = d.header
    // the top band of each window keeps the one below's position, unless
    // the right channel is nonzero there
    blocks @r1 = 1
    ns @r2 = g.n_short_sfb
    #(ns - 0)
    if #ne {
        blocks = 3
    }
    ist @r8 = &mp3_scratch.ist_pos as *u8
    ist += 39
    dflt @r11 = 0
    #(h & HDR_MPEG1)
    if #ne {
        dflt = 3
    }
    itop @r2 = nsfb - blocks
    i @r7 = 0
    loop {
        prev @r3 = itop - blocks
        band @r12 = *(mb + i * 4)
        v @lr = dflt
        #(band - prev)
        if #lt {
            v = *(ist + prev)
        }
        *(ist + itop) = v
        itop += 1
        i += 1
        #(i - blocks)
        if #lo goto loop
    }
    g1 @r0 = g + size(Mp3Gr)
    sh @r11 = g1.scalefac_compress
    sh &= 1
    // l3_stereo_process
    maxpos @r9 = 64
    #(h & HDR_MPEG1)
    if #ne {
        maxpos = 7
    }
    s @s16 = 1.0
    if {
        #(h & HDR_MS_STEREO)
        if #eq goto end
        s = 1.41421356
    }
    l @r5 = &mp3_scratch.grbuf as *f32
    i = 0
    m3 = 0
    loop {
        n @r1 = *(sfb + i)
        #(n - 0)
        if #eq goto break
        ipos @r2 = *(ist + i)
        if {
            mb @r0 = &sp.max_band as *u32
            band @r0 = *(mb + m3 * 4)
            #(i - band)
            if #le goto else
            #(ipos - maxpos)
            if #hs goto else
            if {
                #(h & HDR_MPEG1)
                if #eq goto else
                pan @r0 = &mp3_pan as *f32
                pan = pan + (ipos << 3)
                (kl @s2, kr @s3) = *pan
                goto end
            } else {
                // k = 2^(-((ipos + 1) >> 1 << sh) / 4) on one side
                sp.saved = ipos
                e @r0 = ipos + 1
                e >>= 1
                e <<= sh
                one @s0 = 1.0
                k @s0 = call mp3_ldexp_q2(one, e)
                one @s1 = 1.0
                ipos @r2 = sp.saved
                kl @s2 = k
                kr @s3 = one
                #(ipos & 1)
                if #eq {
                    kl = one
                    kr = k
                }
            }
            xl @s0 = kl * s
            xr @s1 = kr * s
            a @r0 = l
            n @r1 = *(sfb + i)
            call mp3_is_band(a, n, xl, xr)
            goto end
        } else {
            #(h & HDR_MS_STEREO)
            if #eq goto end
            a @r0 = l
            call mp3_ms_band(a, n)
        }
        n @r1 = *(sfb + i)
        l = l + (n << 2)
        i += 1
        m3 += 1
        #(m3 - 3)
        if #eq {
            m3 = 0
        }
        goto loop
    }
    sp += 16
    pop(s16)
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// Reorder short blocks, from window by window to line by line, through
// the scratch part of mp3_decoder.syn
#[link_section = ".text"]
fn mp3_reorder(grbuf: *u32, sfb: *u8) {
    push(grbuf, r4, r5, r6, r7, lr)
    src @r0 = grbuf
    d @r2 = &mp3_decoder.syn as *u32
    d += 960 * 4
    loop {
        len @r3 = *sfb
        sfb += 3
        if len == 0 goto break
        l4 @r6 = len << 2
        l8 @lr = len << 3
        loop {
            a @r4 = *src
            b @r5 = *(src + l4)
            c @r7 = *(src + l8)
            *d++ = (a, b, c)
            src += 4
            #(len -= 1)
            if #ne goto loop
        }
        src += l8
        goto loop
    }
    s @r1 = &mp3_decoder.syn as *u32
    s += 960 * 4
    n @r2 = d - s
    n >>= 2
    g @r0 = sp.grbuf
    call mp3_copy_words(g, s, n)
    pop(r0, r4, r5, r6, r7, pc)
}

// The alias reduction butterflies between each pair of long bands
#[link_section = ".ram"]
fn mp3_antialias(grbuf: *f32, nbands) {
    #(nbands - 0)
    if #eq goto done
    push(s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31)
    t @r2 = &mp3_aa as *f32
    (cs0 @s16, cs1 @s17, cs2 @s18, cs3 @s19, cs4 @s20, cs5 @s21, cs6 @s22, cs7 @s23, ca0 @s24, ca1 @s25, ca2 @s26, ca3 @s27, ca4 @s28, ca5 @s29, ca6 @s30, ca7 @s31) = *t
    p @r0 = grbuf + 18 * 4
    // The 8 butterflies of a band boundary, 4 at a time: u at p up, d at
    // p - 4 down, x = u cs - d ca to u and y = u ca + d cs to d
    loop {
        #(nbands -= 1)
        q @r2 = p - 16
        pu @r3 = p + 16
        qd @r12 = p - 32
        (u0 @s0, u1 @s1, u2 @s2, u3 @s3) = *p
        (d3 @s4, d2 @s5, d1 @s6, d0 @s7) = *q
        x0 @s8 = u0 * cs0
        t0 @s15 = d0 * ca0
        dc0 @s7 = d0 * cs0
        ua0 @s0 = u0 * ca0
        x0 = x0 - t0
        y0 @s15 = ua0 + dc0
        x1 @s9 = u1 * cs1
        t1 @s14 = d1 * ca1
        dc1 @s6 = d1 * cs1
        ua1 @s1 = u1 * ca1
        x1 = x1 - t1
        y1 @s14 = ua1 + dc1
        x2 @s10 = u2 * cs2
        t2 @s13 = d2 * ca2
        dc2 @s5 = d2 * cs2
        ua2 @s2 = u2 * ca2
        x2 = x2 - t2
        y2 @s13 = ua2 + dc2
        x3 @s11 = u3 * cs3
        t3 @s12 = d3 * ca3
        dc3 @s4 = d3 * cs3
        ua3 @s3 = u3 * ca3
        x3 = x3 - t3
        y3 @s12 = ua3 + dc3
        *p = (x0, x1, x2, x3)
        *q = (y3, y2, y1, y0)
        (u4 @s0, u5 @s1, u6 @s2, u7 @s3) = *pu
        (d7 @s4, d6 @s5, d5 @s6, d4 @s7) = *qd
        x4 @s8 = u4 * cs4
        t4 @s15 = d4 * ca4
        dc4 @s7 = d4 * cs4
        ua4 @s0 = u4 * ca4
        x4 = x4 - t4
        y4 @s15 = ua4 + dc4
        x5 @s9 = u5 * cs5
        t5 @s14 = d5 * ca5
        dc5 @s6 = d5 * cs5
        ua5 @s1 = u5 * ca5
        x5 = x5 - t5
        y5 @s14 = ua5 + dc5
        x6 @s10 = u6 * cs6
        t6 @s13 = d6 * ca6
        dc6 @s5 = d6 * cs6
        ua6 @s2 = u6 * ca6
        x6 = x6 - t6
        y6 @s13 = ua6 + dc6
        x7 @s11 = u7 * cs7
        t7 @s12 = d7 * ca7
        dc7 @s4 = d7 * cs7
        ua7 @s3 = u7 * ca7
        x7 = x7 - t7
        y7 @s12 = ua7 + dc7
        *pu = (x4, x5, x6, x7)
        *qd = (y7, y6, y5, y4)
        p += 18 * 4
        if #ne goto loop
    }
    pop(s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31)
done:
    bx lr
}

// The 9 point DCT at y, in place, scheduled by tools/sched.py
#[link_section = ".ram"]
fn mp3_dct9(y: *f32) {
    (e0 @s0, o1 @s1, e2 @s2, o3 @s3, e4 @s4, o5 @s5, e6 @s6, o7 @s7, e8 @s8) = *y
    half @s9 = 0.5
    k @r1 = &mp3_dct9_k as *f32
    t0 @s10 = e6 * half
    t4 @s11 = e4 + e2
    t2 @s12 = e8 + e2
    d @s2 = e8 - e2
    t0 @s10 = e0 + t0
    e0 @s0 = e0 - e6
    t0_3 @s6 = o5 + o1
    e6 @s8 = e4 - e8
    e4 @s4 = e4 + d
    t4_3 @s2 = o5 - o7
    o1_2 @s5 = o1 - o5
    t2_3 @s1 = o1 + o7
    o1 @s5 = o1_2 - o7
    c @s7 = *(k + 4)
    t4 @s11 = t4 * c
    c @s7 = *(k + 8)
    t2 @s12 = t2 * c
    c3 @s7 = *(k + 16)
    o3 @s3 = o3 * c3
    o1 @s5 = o1 * c3
    c @s7 = *(k + 20)
    t0_4 @s6 = t0_3 * c
    c @s7 = *(k + 24)
    t4_4 @s2 = t4_3 * c
    c @s7 = *(k + 12)
    e6 @s8 = e6 * c
    c @s7 = *(k + 28)
    t2_4 @s1 = t2_3 * c
    d @s9 = e4 * half
    e8 @s7 = t0 - t2
    e2 @s9 = e0 - d
    d @s4 = e4 + e0
    e0 @s0 = t0 - t4
    e4 @s10 = t0 + t4
    o5 @s11 = t0_4 - o3
    e0 @s0 = e0 + t2
    o7 @s12 = t4_4 - o3
    o3 @s2 = t4_4 + o3
    e8 @s7 = e8 + e6
    e4 @s10 = e4 - e6
    o5 @s11 = o5 - t2_4
    o7 @s12 = o7 - t0_4
    o3 @s2 = o3 - t2_4
    d_4 @s1 = e4 - o7
    d_5 @s3 = e2 + o1
    d_6 @s6 = e0 - o3
    d_7 @s8 = e8 + o5
    d_8 @s7 = e8 - o5
    d_9 @s0 = e0 + o3
    d_10 @s9 = e2 - o1
    d_11 @s10 = e4 + o7
    *(y + 16) = d
    *y = d_4
    *(y + 4) = d_5
    *(y + 8) = d_6
    *(y + 12) = d_7
    *(y + 20) = d_8
    *(y + 24) = d_9
    *(y + 28) = d_10
    *(y + 32) = d_11
    bx lr
}

// The 36 point IMDCT of nbands long blocks, with overlap-add
#[link_section = ".ram"]
fn mp3_imdct36(grbuf: *f32, overlap: *f32, window: *f32, nbands) {
    push(r4, r5, r6, r7, r8, lr)
    sp -= 72 (co: [f32; 9], si: [f32; 9])
    g @r4 = grbuf
    ov @r5 = overlap
    win @r8 = window
    n @r7 = nbands
    tw @r6 = &mp3_twid9 as *f32
    loop {
        // the DCT inputs, scheduled by tools/sched.py
        q @r0 = &sp.co as *f32
        ga @r1 = g + 4
        x @s0 = *g
        (xa @s1, xb @s2, xc @s3, xd @s4) = *ga
        ga @r1 = g + 20
        v @s5 = xc + xd
        (xa2 @s6, xb2 @s7, xc2 @s8, xd2 @s9) = *ga
        ga @r1 = g + 36
        v9 @s10 = xc2 + xd2
        (xa3 @s11, xb3 @s12, xc3 @s13, xd3 @s14) = *ga
        v3 @s4 = xd - xc
        v8 @s9 = xd2 - xc2
        *(q + 64) = v3
        ga @r1 = g + 52
        v14 @s3 = xc3 + xd3
        v13 @s14 = xd3 - xc3
        x @s0 = -x
        v1 @s4 = xa - xb
        v2 @s1 = xa + xb
        v @s5 = -v
        v6 @s2 = xa2 - xb2
        v7 @s6 = xa2 + xb2
        v10 @s10 = -v9
        v11 @s7 = xa3 - xb3
        v12 @s11 = xa3 + xb3
        v15 @s3 = -v14
        x3 @s8 = *(g + 68)
        *q = x
        *(q + 36) = x3
        *(q + 68) = v1
        *(q + 4) = v2
        *(q + 8) = v
        *(q + 60) = v6
        *(q + 12) = v7
        *(q + 56) = v8
        *(q + 16) = v10
        *(q + 52) = v11
        (xa @s4, xb @s5, xc @s6, xd @s7) = *ga
        v @s0 = xc + xd
        v16 @s1 = xa - xb
        v17 @s4 = xa + xb
        v18 @s7 = xd - xc
        v @s0 = -v
        *(q + 20) = v12
        *(q + 48) = v13
        *(q + 24) = v15
        *(q + 44) = v16
        *(q + 28) = v17
        *(q + 40) = v18
        *(q + 32) = v
