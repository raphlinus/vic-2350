// Play VIDEO.NIB from the root directory of the SD card at 60 fps: 640x480
// nibnib frames (as in sd_image.sy), each padded to FRAME_BLOCKS blocks,
// as made by tools/nibvid, looping.
//
// Each run of contiguous clusters is one CMD18, read into a ring of two
// frame slots with DMA channels 2 and 3, chained: each writes one slot, CRCs
// included, then triggers the other, and vid_poll sets it up again. Frame g
// goes in slot g & 1. Flow control is stopping SM0, which stops
// CLK, so the card waits: the stream may run into the slot on screen, with
// the frame after next, but only up to MARGIN_BLOCKS behind the line being
// drawn. A new frame is shown at line 0 only if all its blocks are in,
// otherwise the last one is shown again.
// At the end of a run, which can be anywhere in a slot, the channel doesn't
// chain, and the next run is CMD12, then a new CMD18 and the rest of the
// slot. Each one costs about a quarter of a millisecond of the card's time,
// out of the 7 ms a frame has to spare.
//
// demo_line polls all this every line, then copies the line's words out
// of the slot (skipping each block's CRC words) and decodes them. Stats
// are logged over USB after each of the first LOG_PASSES passes.
//
// Its functions each have a section of their own, as in sd.sy.

const FRAME_BLOCKS = 306
// a slot: a frame's blocks as read, CRCs included
const SLOT_WORDS = FRAME_BLOCKS * BLOCK_WORDS
// A nibnib frame, in words: the width and height, 256 pixel pair deltas,
// then lines of the first pixel pair and an index byte per following pair
const NIB_PALETTE_W = 1
const NIB_LINES_W = NIB_PALETTE_W + 256
const NIB_STRIDE_W = (4 + H_ACTIVE / 2) / 4
const NIB_HEADER = H_ACTIVE | (V_ACTIVE << 16)
// How close (in blocks) the stream may come behind the line being drawn
// before the clock is stopped. Lines are polled every 32 us or so, about a
// block, but not during vertical blanking, 1.4 ms or about 48 blocks. The
// clock starts again once there's RESUME_BLOCKS of room.
const MARGIN_BLOCKS = 80
const RESUME_BLOCKS = 16
const LOG_PASSES = 3
// The runs of clusters a file can be in
const MAX_RUNS = 512
const FAIL_PIXELS = 0xf800f800

// DMA channels 2 and 3 as in SD_DMA_CTRL, chaining to channel 2 or 3
const VID_CTRL_TO2 = (SD_DMA_CTRL & !(15 << 13)) | (2 << 13)
const VID_CTRL_TO3 = (SD_DMA_CTRL & !(15 << 13)) | (3 << 13)

struct Video {
    // the file's runs of clusters and whole frames
    runs: u32
    total: u32
    // the run being read, the block of the stream where it ends, and
    // whether the DMA has got there
    run: u32
    run_end: u32
    at_end: u32
    // frames the DMA has finished
    done: u32
    // the frame on screen, whether one is yet, and how far it is into the
    // file
    cur: u32
    started: u32
    pass_frame: u32
    // whether SM0 (so CLK) is stopped
    stopped: u32
    // stats for the log
    passes: u32
    stops: u32
    repeats: u32
    restarts: u32
    bad: u32
    missed0: u32
    failed: u32
    // the longest CMD12 and CMD18 restart, and pass log, in cycles
    restart_max: u32
    log_max: u32
}

static mut vid: Video
// Each run of the file: its first block and how many blocks to read
static mut vid_runs: [u32; 2 * MAX_RUNS]
// a line's words, and the frame's palette, out of the slot
static mut vid_line: [u32; NIB_STRIDE_W]
static mut vid_pal: [u32; 256]
// The two slots. Not zeroed at startup, being too big for .bss.
#[link_section = ".uninit"]
static mut vid_ring: [u32; 2 * SLOT_WORDS]

static video_name: [u8; _] = "VIDEO   NIB"
static size_str: [u8; _] = "VIDEO.NIB bytes "
static frames_str: [u8; _] = "VIDEO.NIB frames "
static runs_str: [u8; _] = "VIDEO.NIB runs of clusters "
static pass_str: [u8; _] = "pass "
static shown_str: [u8; _] = "  frames shown "
static repeats_str: [u8; _] = "  frames repeated (the next wasn't in) "
static stops_str: [u8; _] = "  clock stops "
static restarts_str: [u8; _] = "  CMD18 restarts "
static bad_str: [u8; _] = "  bad frame headers "
static missed_str: [u8; _] = "  lines missed "
static rmax_str: [u8; _] = "  longest restart, cycles "
static lmax_str: [u8; _] = "  longest pass log, cycles "
static short_str: [u8; _] = "VIDEO.NIB has under 2 frames"
static badchain_str: [u8; _] = "VIDEO.NIB's cluster chain is too long or too short"
static cmdfail_str: [u8; _] = "command failed"
static fail_str: [u8; _] = "failed"

#[link_section = ".text"]
fn demo_init() {
    push(r4, r5, r6, lr)
    zero @r1 = 0
    pw @r0 = &sd_verbose
    *pw = zero
    status @r0 = call sd_init()
    #(status - 0)
    if #ne goto fail
    status @r0 = call sd_set_wide()
    #(status - 0)
    if #ne goto fail
    status @r0 = call sd_switch_hs()
    #(status - 0)
    if #ne goto fail
    status @r0 = call fat_mount()
    #(status - 0)
    if #ne goto fail

    p @r0 = &video_name
    status @r0 = call fat_find_root(p)
    #(status - 0)
    if #ne goto fail
    pw @r0 = &fat_found_size
    size @r4 = *pw
    p @r0 = &size_str
    len @r1 = count(size_str)
    v @r2 = r4
    call log_kvd(p, len, v)
    k @r1 = FRAME_BLOCKS * 512
    n @r1 = r4 / k
    vd @r0 = &vid
    vd.total = n
    p @r0 = &frames_str
    len @r1 = count(frames_str)
    vd @r2 = &vid
    v @r2 = vd.total
    call log_kvd(p, len, v)
    vd @r0 = &vid
    n @r0 = vd.total
    #(n - 2)
    if {
        if #hs goto end
        p @r0 = &short_str
        len @r1 = count(short_str)
        call log_line(p, len)
        goto fail
    }
    pw @r0 = &fat_found_clus
    c @r0 = *pw
    status @r0 = call vid_find_runs(c)
    failed @r4 = status
    p @r0 = &runs_str
    len @r1 = count(runs_str)
    vd @r2 = &vid
    v @r2 = vd.runs
    call log_kvd(p, len, v)
    if {
        if failed == 0 goto end
        p @r0 = &badchain_str
        len @r1 = count(badchain_str)
        call log_line(p, len)
        goto fail
    }

    status @r0 = call vid_start()
    #(status - 0)
    if #ne goto fail
    pop(r4, r5, r6, pc)

fail:
    p @r0 = &fail_str
    len @r1 = count(fail_str)
    call log_line(p, len)
    call log_end()
    one @r1 = 1
    vd @r0 = &vid
    vd.failed = one
    pop(r4, r5, r6, pc)
}

// Fill in vid_runs and vid.runs from the chain from cluster c, up to the
// file's last whole frame. Returns 0, or 1 if the chain has more than
// MAX_RUNS runs or stops short.
#[link_section = ".text"]
fn vid_find_runs(c: u32) -> status: u32 {
    push(r4, r5, r6, r7, r8, r9, r10, lr)
    c @r4 = c
    f @r0 = &fat
    spc @r6 = f.sec_per_clus
    vd @r0 = &vid
    limit @r10 = vd.total
    k @r1 = FRAME_BLOCKS
    limit *= k
    table @r5 = &vid_runs
    // the file's blocks so far, and the run's first cluster and block
    o @r7 = 0
    loop {
        start @r8 = r4
        o0 @r9 = r7
        // to the end of the run
        loop {
            o += spc
            c_ @r0 = r4
            next @r0 = call fat_next(c_)
            follow @r1 = r4 + 1
            #(next - follow)
            if #ne goto break
            c @r4 = next
            goto loop
        }
        c @r4 = next
        vd @r0 = &vid
        n @r1 = vd.runs
        #(n - MAX_RUNS)
        if #hs goto bad
        n += 1
        vd.runs = n
        c_ @r0 = r8
        lba @r0 = call fat_clus_lba(c_)
        // the last cluster can run past the file's last frame
        last @r1 = r7
        #(last - limit)
        if {
            if #ls goto end
            last = limit
        }
        last -= o0
        *table = lba
        *(table + 4) = last
        table += 8
        #(o - limit)
        if #hs goto break
        eoc @r1 = 0x0ffffff8
        #(r4 - eoc)
        if #hs goto bad
        #(r4 - 2)
        if #lo goto bad
        goto loop
    }
    status @r0 = 0
    pop(r4, r5, r6, r7, r8, r9, r10, pc)

bad:
    status @r0 = 1
    pop(r4, r5, r6, r7, r8, r9, r10, pc)
}

// Set up the channel for the slot of block pos of the stream, without
// starting it: from pos up to the end of the slot or to run_end, whichever
// comes first. It chains to the other channel only if the run goes on past
// the slot. With pos at or past run_end, it just waits at the start of the
// slot.
#[link_section = ".ram"]
fn vid_arm(pos: u32, run_end: u32) {
    push(r4, r5, r6, r7, r8, lr)
    k @r2 = FRAME_BLOCKS
    g @r3 = pos / k
    last @r12 = g + 1
    last *= k
    stop @r4 = last
    #(run_end - stop)
    if {
        if #hs goto end
        stop = run_end
    }
    #(stop - pos)
    if {
        if #hs goto end
        stop = pos
    }
    n @r5 = stop - pos
    t @r2 = g * k
    off @r0 = pos - t
    b @r2 = BLOCK_WORDS * 4
    off *= b
    ch @r6 = peripherals.DMA as *DmaChannel
    ch += 0x80
    ring @r2 = &vid_ring
    if {
        #(g & 1)
        if #eq goto end
        ch += 0x40
        slot @r7 = SLOT_WORDS * 4
        ring += slot
    }
    ring += off
    ch.write_addr = ring
    w @r2 = BLOCK_WORDS
    n *= w
    ch.trans_count = n
    ctrl @r2 = VID_CTRL_TO2
    other @r5 = VID_CTRL_TO3
    if {
        #(g & 1)
        if #eq goto end
        ctrl = VID_CTRL_TO3
        other = VID_CTRL_TO2
    }
    // past the slot?
    if {
        #(stop - last)
        if #ne goto end
        #(run_end - last)
        if #ls goto end
        ctrl = other
    }
    ch.al1_ctrl = ctrl
    pop(r4, r5, r6, r7, r8, pc)
}

// Start reading the run vid.run, at the block of the stream where the last
// one ended, which can be anywhere in a slot. Both channels must be idle.
// Sends CMD18 and returns its status.
#[link_section = ".text"]
fn vid_start() -> status: u32 {
    push(r4, r5, r6, r7, r8, lr)
    in_ @r0 = PIO_IN_PINS_4
    x @r1 = RX4_NIBBLES - 1
    call sd_rx_load(in_, x)

    dma @r0 = peripherals.DMA
    bits @r1 = 3 << 2
    dma.INTR = bits
    ch @r0 = peripherals.DMA as *DmaChannel
    ch += 0x80
    pio @r1 = peripherals.PIO1
    rx @r1 = &pio.RXF1
    ch.read_addr = rx
    ch += 0x40
    ch.read_addr = rx

    v @r4 = &vid
    i @r0 = v.run
    table @r1 = &vid_runs
    table += i * 8
    lba @r6 = *table
    n @r1 = *(table + 4)
    start @r7 = v.run_end
    run_end @r5 = start + n
    v.run_end = run_end
    zero @r1 = 0
    v.at_end = zero
    // the next slot first, as this one can chain to it
    k @r1 = FRAME_BLOCKS
    g @r2 = start / k
    g += 1
    pos @r0 = g * k
    run_end @r1 = r5
    call vid_arm(pos, run_end)
    pos @r0 = r7
    run_end @r1 = r5
    call vid_arm(pos, run_end)

    // and start it
    v @r4 = &vid
    done @r1 = v.done
    ch @r0 = peripherals.DMA as *DmaChannel
    ch += 0x80
    if {
        #(done & 1)
        if #eq goto end
        ch += 0x40
    }
    ctrl @r1 = ch.al1_ctrl
    ch.ctrl_trig = ctrl
    zero @r1 = 0
    v.stopped = zero
    pio @r0 = peripherals.PIO1
    both @r1 = SD_CTRL_ALL
    pio.CTRL = both

    index @r0 = 18
    pw @r1 = &sd_addr_shift
    shift @r1 = *pw
    arg @r1 = lba << shift
    rbits @r2 = 48
    status @r0 = call sd_command(index, arg, rbits)
    pop(r4, r5, r6, r7, r8, pc)
}

// End a run, with CMD12, and start the next, wrapping around at the end of
// the file.
#[link_section = ".text"]
fn vid_restart() {
    push(r4, lr)
    // the bus on to send commands, SM1 off
    in_ @r0 = PIO_IN_PINS_4
    x @r1 = RX4_NIBBLES - 1
    call sd_rx_load(in_, x)
    index @r0 = 12
    arg @r1 = 0
    rbits @r2 = 48
    status @r0 = call sd_command(index, arg, rbits)
    #(status - 0)
    if #ne goto fail
    call sd_wait_busy()
    v @r0 = &vid
    n @r1 = v.restarts
    n += 1
    v.restarts = n
    i @r1 = v.run
    i += 1
    runs @r2 = v.runs
    #(i - runs)
    if {
        if #ne goto end
        i = 0
    }
    v.run = i
    status @r0 = call vid_start()
    #(status - 0)
    if #ne goto fail
    pop(r4, pc)

fail:
    p @r0 = &cmdfail_str
    len @r1 = count(cmdfail_str)
    call log_line(p, len)
    call log_end()
    one @r1 = 1
    v @r0 = &vid
    v.failed = one
    pop(r4, pc)
}

// Keep the stream going, before line y: count the slots the DMA has
// finished, setting their channels up for the slot after next, and note
// when it stops at the end of a run. At line 0, move on to the next frame
// if it's in. Then stop or restart CLK for flow control, or start the next
// run once there's room.
#[link_section = ".ram"]
fn vid_poll(y: u32) {
    push(r4, r5, r6, r7, r8, lr)
    y @r7 = y
    v @r4 = &vid
    done @r5 = v.done
    // Only the channel for frame done can have finished, then the next
    loop {
        x @r1 = done & 1
        bit @r0 = 1 << 2
        bit <<= x
        dma @r2 = peripherals.DMA
        intr @r3 = dma.INTR
        intr &= bit
        if intr == 0 goto break
        dma.INTR = bit
        ch @r2 = peripherals.DMA as *DmaChannel
        ch += 0x80
        ring @r3 = &vid_ring
        slot @r12 = SLOT_WORDS * 4
        ring += slot
        if {
            if x == 0 goto end
            ch += 0x40
            ring += slot
        }
        // stopped short of the end of the slot: the run ended there
        a @r0 = ch.write_addr
        #(a - ring)
        if {
            if #eq goto end
            one @r0 = 1
            v.at_end = one
            goto break
        }
        done += 1
        v.done = done
        k @r1 = FRAME_BLOCKS
        pos @r0 = done * k
        run_end @r1 = v.run_end
        #(pos - run_end)
        if {
            if #ne goto end
            one @r2 = 1
            v.at_end = one
        }
        k @r2 = FRAME_BLOCKS
        pos += k
        call vid_arm(pos, run_end)
    }

    // blocks in: the finished frames, and the active channel's progress
    k @r0 = FRAME_BLOCKS
    w @r6 = done * k
    ch @r2 = peripherals.DMA as *DmaChannel
    ch += 0x80
    base @r3 = &vid_ring
    if {
        #(done & 1)
        if #eq goto end
        ch += 0x40
        slot @r12 = SLOT_WORDS * 4
        base += slot
    }
    got @r2 = ch.write_addr
    got -= r3
    k @r3 = BLOCK_WORDS * 4
    got = got / k
    w += got

    if {
        if y != 0 goto end
        w_ @r0 = r6
        call vid_frame(w_)
    }

    // The room left: up to the start of the frame after next, plus the
    // blocks of the frame on screen before line y, less the margin
    v @r4 = &vid
    cur @r0 = v.cur
    room @r0 = cur + 2
    k @r1 = FRAME_BLOCKS
    room *= k
    started @r1 = v.started
    if {
        if started == 0 goto end
        stride @r1 = NIB_STRIDE_W
        drawn @r1 = y * stride
        drawn += NIB_LINES_W
        drawn >>= 7
        room += drawn
    }
    room -= w
    #(room - MARGIN_BLOCKS)
    if {
        if #gt goto end
        // too close: stop CLK
        stopped @r1 = v.stopped
        if stopped != 0 goto polled
        pio @r0 = peripherals.PIO1
        sm1 @r1 = SD_CTRL_STOPPED
        pio.CTRL = sm1
        one @r1 = 1
        v.stopped = one
        n @r1 = v.stops
        n += 1
        v.stops = n
        goto polled
    }
    #(room - (MARGIN_BLOCKS + RESUME_BLOCKS))
    if #lt goto polled
    // room again: start the next run, or restart CLK
    at_end @r1 = v.at_end
    if {
        if at_end == 0 goto end
        cyc @r0 = &peripherals.PPB.DWT_CYCCNT
        t0 @r8 = *cyc
        call vid_restart()
        cyc @r0 = &peripherals.PPB.DWT_CYCCNT
        t @r1 = *cyc
        t -= t0
        v @r4 = &vid
        m @r2 = v.restart_max
        #(t - m)
        if {
            if #ls goto end
            v.restart_max = t
        }
        goto polled
    }
    stopped @r1 = v.stopped
    if stopped == 0 goto polled
    pio @r0 = peripherals.PIO1
    both @r1 = SD_CTRL_ALL
    pio.CTRL = both
    zero @r1 = 0
    v.stopped = zero
polled:
    pop(r4, r5, r6, r7, r8, pc)
}

// Copy n words from word off of a frame in the slot at base into dst,
// skipping the CRC words at the end of each block.
#[link_section = ".ram"]
fn vid_copy(dst: *u32, base: *u32, off: u32, n: u32) {
    push(r4, r5, r6, r7)
    loop {
        b @r12 = off >> 7
        within @r4 = off & 127
        chunk @r5 = 128
        chunk -= within
        #(chunk - n)
        if {
            if #ls goto end
            chunk = n
        }
        k @r6 = BLOCK_WORDS * 4
        src @r6 = b * k
        src += base
        src += within * 4
        off += chunk
        n -= chunk
        loop {
            w @r7 = *src++
            #(chunk -= 1)
            *dst++ = w
            if #ne goto loop
        }
        #(n - 0)
        if #ne goto loop
    }
    pop(r4, r5, r6, r7)
    bx lr
}

#[link_section = ".ram"]
fn demo_line(y: u32, pixels: *u32) {
    push(r4, r5, r6, r7, r8, lr)
    y @r4 = y
    pixels @r5 = pixels
    v @r6 = &vid
    failed @r0 = v.failed
    #(failed - 0)
    if #ne goto fail
    y_ @r0 = r4
    call vid_poll(y_)
    v @r6 = &vid
    started @r0 = v.started
    if started == 0 goto blank

    // the frame's slot, and the line's words out of it
    base @r1 = &vid_ring
    cur @r0 = v.cur
    if {
        #(cur & 1)
        if #eq goto end
        k @r2 = SLOT_WORDS * 4
        base += k
    }
    stride @r2 = NIB_STRIDE_W
    off @r2 = y * stride
    off += NIB_LINES_W
    dst @r0 = &vid_line
    n @r3 = NIB_STRIDE_W
    call vid_copy(dst, base, off, n)

    // decode, as sd_image.sy does
    pal @r12 = &vid_pal
    src @r2 = &vid_line
    pair @r0 = *src++
    src8 @r2 = src as *u8
    count @r3 = H_ACTIVE / 2 - 1
    loop {
        ix @r6 = *src8++
        *pixels++ = pair
        delta @r6 = *(pal + ix * 4)
        pair = pkhtb(pair, pair >> 16)
        #(count -= 1)
        pair += delta
        if #ne goto loop
    }
    *pixels++ = pair
    pop(r4, r5, r6, r7, r8, pc)

blank:
    color @r2 = 0
    goto fill
fail:
    color @r2 = FAIL_PIXELS
fill:
    n @r3 = H_ACTIVE / 2
    loop {
        *pixels++ = color
        #(n -= 1)
        if #ne goto loop
    }
    pop(r4, r5, r6, r7, r8, pc)
}

// At line 0: show the next frame if all its blocks are in (w of them so
// far), otherwise the same one again, and copy out its palette. Logs the
// stats at the end of each of the first LOG_PASSES passes.
#[link_section = ".ram"]
fn vid_frame(w: u32) {
    push(r4, r5, r6, lr)
    w @r5 = w
    v @r4 = &vid
    started @r0 = v.started
    next @r1 = v.cur
    if {
        if started == 0 goto end
        next += 1
    }
    // all of frame next is in once w reaches the end of it
    k @r2 = FRAME_BLOCKS
    need @r3 = next + 1
    need *= k
    #(w - need)
    if {
        if #hs goto end
        if started == 0 goto done
        n @r0 = v.repeats
        n += 1
        v.repeats = n
        goto palette
    }
    v.cur = next
    one @r0 = 1
    v.started = one
    pf @r0 = v.pass_frame
    pf += 1
    frames @r1 = v.total
    #(pf - frames)
    if {
        if #ne goto end
        pf = 0
        v.pass_frame = pf
        cyc @r0 = &peripherals.PPB.DWT_CYCCNT
        t0 @r6 = *cyc
        call vid_log()
        cyc @r0 = &peripherals.PPB.DWT_CYCCNT
        t @r1 = *cyc
        t -= t0
        v @r4 = &vid
        m @r2 = v.log_max
        #(t - m)
        if {
            if #ls goto end
            v.log_max = t
        }
        goto palette
    }
    v.pass_frame = pf

palette:
    base @r1 = &vid_ring
    cur @r0 = v.cur
    if {
        #(cur & 1)
        if #eq goto end
        k @r2 = SLOT_WORDS * 4
        base += k
    }
    header @r0 = *base
    want @r2 = NIB_HEADER
    #(header - want)
    if {
        if #eq goto end
        n @r0 = v.bad
        n += 1
        v.bad = n
    }
    dst @r0 = &vid_pal
    off @r2 = NIB_PALETTE_W
    n @r3 = 256
    call vid_copy(dst, base, off, n)
done:
    pop(r4, r5, r6, pc)
}

// Log the stats for the pass just shown, for the first LOG_PASSES passes,
// then end the log.
#[link_section = ".text"]
fn vid_log() {
    push(r4, lr)
    v @r4 = &vid
    n @r0 = v.passes
    #(n - LOG_PASSES)
    if #hs goto done
    n += 1
    v.passes = n
    x @r2 = n
    p @r0 = &pass_str
    len @r1 = count(pass_str)
    call log_kvd(p, len, x)
    p @r0 = &shown_str
    len @r1 = count(shown_str)
    v @r4 = &vid
    x @r2 = v.cur
    x += 1
    call log_kvd(p, len, x)
    p @r0 = &repeats_str
    len @r1 = count(repeats_str)
    v @r4 = &vid
    x @r2 = v.repeats
    call log_kvd(p, len, x)
    p @r0 = &stops_str
    len @r1 = count(stops_str)
    v @r4 = &vid
    x @r2 = v.stops
    call log_kvd(p, len, x)
    p @r0 = &restarts_str
    len @r1 = count(restarts_str)
    v @r4 = &vid
    x @r2 = v.restarts
    call log_kvd(p, len, x)
    p @r0 = &bad_str
    len @r1 = count(bad_str)
    v @r4 = &vid
    x @r2 = v.bad
    call log_kvd(p, len, x)
    p @r0 = &missed_str
    len @r1 = count(missed_str)
    d @r2 = &dvi
    x @r2 = d.missed_lines
    call log_kvd(p, len, x)
    p @r0 = &rmax_str
    len @r1 = count(rmax_str)
    v @r4 = &vid
    x @r2 = v.restart_max
    call log_kvd(p, len, x)
    p @r0 = &lmax_str
    len @r1 = count(lmax_str)
    v @r4 = &vid
    x @r2 = v.log_max
    call log_kvd(p, len, x)
    v @r4 = &vid
    n @r0 = v.passes
    #(n - LOG_PASSES)
    if {
        if #ne goto end
        call log_end()
    }
done:
    pop(r4, pc)
}

// Nothing to do in thread mode
fn demo_main() {
    bx lr
}
