use "font.sy"
use "main.sy"
use "render.sy"
use "display_list.sy"
use "pico_alloc.sy"

// Text, with the font in font.sy. A text object's start method compiles
// its string into Thumb code that renders one row of the text as 1bpp
// pixels, packed least significant bit first, and that code is run once
// per line. The generated code takes the font row in r0 and the output in
// r1, uses r2-r4, and for each glyph is:
//
//     ldr r4, [r0, #word]          @ the font word holding the glyph
//     <delay>                      @ the previous glyph's last instruction
//     ubfx r3, r4, #lsb, #width    @ the glyph's pixels
//
// r2 accumulates an output word, which isn't stored until a glyph starts or
// ends past it. The delay instruction, which fills the load's delay slot,
// merges the glyph into r2 with orr r2, r2, r3, lsl #shift. A glyph that
// crosses a word boundary instead extracts into r4, puts the finished word
// in r3 and the rest in r2, and its delay is stmia r1!, {r3}. A glyph that
// starts past the word stores r2 before its ubfx, and its delay is lsls r2,
// r3, #shift. A blank glyph generates no code.
//
// A glyph can start left of the word in r2, in the word before it, which
// has been stored. That word is loaded and stored again:
//
//     ldr r4, [r0, #word]
//     <delay>
//     ubfx r4, r4, #lsb, #width
//     subs r1, #4
//     ldr r3, [r1]
//     orr r2, r2, r4, lsr #32 - shift
//     orr r3, r3, r4, lsl #shift
//
// and its delay is stmia r1!, {r3}.

// The font format. Each of the FONT_HEIGHT rows of font_bits is FONT_STRIDE
// bytes, with pixels packed least significant bit first, and a glyph's
// bitmap has no blank columns. font_glyphs[c - FONT_FIRST] has these fields:
//
//     [0..16]   the bit where the glyph's bitmap starts in each row
//     [16..20]  signed, the bitmap's left edge relative to the origin
//     [20..26]  the bitmap's width in pixels, at most 32; 0 for a blank
//     [26..32]  the advance, from this glyph's origin to the next one's;
//               signed for a blank, as kern codes have negative advances

// Instruction templates indexed by a 5 bit field, as two halfwords in a
// word, which don't depend on the font: jit_orr[n] is orr r2, r2, r3,
// lsl #n, the usual delay, and jit_ubfx[n] is ubfx r3, r4, #n, #0, ready
// for the glyph's width to be added at bit 16.
#[link_section = ".ram"]
static mut jit_orr: [u32; 32]
#[link_section = ".ram"]
static mut jit_ubfx: [u32; 32]

// Thumb encodings used by the generator
const T_MOVS_R2_0 = 0x2200
const T_MOVS_R2_R3 = 0x001a
const T_STMIA_R2 = 0xc104
const T_STMIA_R3 = 0xc108
const T_BX_LR = 0x4770
const T_LDR_R4_R0 = 0x6804
// ubfx r3, r4, #0, #1, both halfwords; add 1 << 24 for Rd = r4
const T_UBFX_R3_R4 = 0x0300f3c4
// subs r1, #4; ldr r3, [r1]
const T_SUBS_LDR = 0x680b3904
// orr r2, r2, r3, lsl #0; add 0x01010000 for orr r3, r2, r4
const T_ORR_R2_R2_R3 = 0x0203ea42
// add 0x00110000 for orr r2, r2, r4, lsr #0
const ORR_LSR_R4 = 0x00110000
// lsrs r2, r4, #32 - n is T_LSRS_R2_R4_32 - (n << 6)
const T_LSRS_R2_R4_32 = 0x1022

// Fill jit_orr and jit_ubfx. Call once, before any text is started.
fn text_init() {
    orr_t @r0 = &jit_orr
    ubfx_t @r1 = &jit_ubfx
    n @r2 = 32
    loop {
        #(n -= 1)
        // n in the second halfword: imm3 in bits 12-14 and imm2 in bits 6-7
        f @r3 = n & 3
        hi @r12 = n >> 2
        f <<= 22
        f |= hi << 28
        orr @r12 = T_ORR_R2_R2_R3
        orr |= f
        *(orr_t + n * 4) = orr
        // width - 1 goes in bits 16-20, so take 1 off for the width to add;
        // that borrows from bits 22-23, so f is added, not ored
        ubfx @r12 = T_UBFX_R3_R4 - (1 << 16)
        ubfx += f
        *(ubfx_t + n * 4) = ubfx
        if #ne goto loop
    }
    bx lr
}

// Compile n (at least 1) characters of text into code. Returns the end of
// the code, which with the room needed while generating takes at most
// text_code_size bytes. A first glyph that extends left of its origin
// moves the text right, as in text_width.
#[link_section = ".ram"]
#[align = 4]
fn jit_text(code: *u16, text: *u8, n: u32) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    glyphs @r9 = &font_glyphs
    c @r8 = *text++
    orr_table @lr = &jit_orr
    ubfx_table @r5 = &jit_ubfx
    glyphs -= FONT_FIRST * 4
    ldr_base @r10 = T_LDR_R4_R0
    // Each glyph's ldr goes in slot, ahead of the delay instruction,
    // which is written as soon as it's known.
    slot @r3 = code
    first_delay @r7 = T_MOVS_R2_0
    *(code + 2) = first_delay
    code += 4
    // pen: the next glyph's origin, relative to the start of the output
    // word in r2. It's negative when the last glyph ended past the pen.
    g @r12 = *(glyphs + c * 4)
    pen @r6 = 0
    left @r4 = (g as i32)[16..20]
    #(left - 0)
    if #lt {
        pen -= left
    }
    loop {
glyph:
        g @r12 = *(glyphs + c * 4)
        // the next character, reading one past the end
        c = *text++
        width @r7 = g[20..26]
        bit_offset @r4 = g & 31
        if width == 0 goto blank
        // ubfx r3, r4, #offset % 32, #width
        ubfx_instr @r11 = *(ubfx_table + bit_offset * 4)
        // ldr r4, [r0, #offset / 32]; the font is narrower than 32 words,
        // so the offset fits, and strh leaves out what's above it.
        word_offset @r4 = g >> 5
        ldr @r4 = ldr_base + (word_offset << 6)
        ubfx_instr += width << 16
        *slot = ldr
        // left side bearing
        left @r4 = (g as i32)[16..20]
        *(code as *u32) = ubfx_instr
        // shift: where the glyph starts, relative to the word in r2. Branch is
        // also taken if negative.
        shift @r4 = pen + left
        room @r7 = 32 - width
        pen += g >> 26
        #(shift - room)
        if #hi goto off_word
        // the delay: orr r2, r2, r3, lsl #shift
        d @r12 = *(orr_table + shift * 4)
        *((code + 6) as *u32) = d
        slot = code + 4
        code += 10
        #(n -= 1)
        if #ne goto loop
    }
finish:
    // The last slot isn't needed: move the last delay back over it.
    d @r4 = *((slot + 2) as *u32)
    code -= 2
    *(slot as *u32) = d
    // Words that trailing blanks passed over
    while {
        #(pen - 32)
        if #le goto break
        z @r12 = T_STMIA_R2 | (T_MOVS_R2_0 << 16)
    } loop {
        *(code as *u32) = z
        code += 4
        pen -= 32
        #(pen - 32)
        if #gt goto loop
    }
    // End with stmia r1!, {r2}; bx lr.
    tail @r12 = T_STMIA_R2 | (T_BX_LR << 16)
    *(code as *u32) = tail
    code += 4
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)

blank:
    // signed: a kern code moves back
    pen += (g as i32) >> 26
    #(n -= 1)
    if #ne goto glyph
    goto finish

off_word:
    #(shift - 0)
    if #lt goto behind
    // last: where the glyph ends in the output word
    last @r7 = 32 - room
    last += shift
    #(shift - 32)
    if #hs goto outside
straddle:
    // ubfx r4, r4, ...; orr r3, r2, r4, lsl #shift;
    // lsrs r2, r4, #32 - shift; then the delay is stmia r1!, {r3}
    ubfx_instr += 1 << 24
    d @r7 = *(orr_table + shift * 4)
    *(code as *u32) = ubfx_instr
    lsrs_instr @r12 = T_LSRS_R2_R4_32
    d += 0x01000000
    lsrs_instr -= shift << 6
    d += 0x00010000
    *((code + 4) as *u32) = d
    stm @r7 = T_STMIA_R3
    *(code + 8) = lsrs_instr
    *(code + 12) = stm
    slot = code + 10
    code += 14
    pen -= 32
    #(n -= 1)
    if #ne goto glyph
    goto finish

outside:
    // The glyph starts past the word in r2: store it, and any words of
    // zeros that blanks passed over.
    loop {
        shift -= 32
        insn @r12 = T_STMIA_R2
        *code = insn
        code += 2
        last -= 32
        pen -= 32
        #(shift - 32)
        if #lo goto break
        insn = T_MOVS_R2_0
        *code = insn
        code += 2
        goto loop
    }
    #(last - 32)
    if #hi goto clear
    // ubfx, then the delay is lsls r2, r3, #shift
    *(code as *u32) = ubfx_instr
    lsls_instr @r12 = T_MOVS_R2_R3
    lsls_instr += shift << 6
    *(code + 6) = lsls_instr
    slot = code + 4
    code += 8
    #(n -= 1)
    if #ne goto glyph
    goto finish

clear:
    // only after blanks: an empty r2 for the straddle
    empty @r12 = T_MOVS_R2_0
    *code = empty
    code += 2
    goto straddle

behind:
    // The glyph starts in the word before the one in r2.
    ubfx_instr += 1 << 24
    s @r7 = shift + 32
    *(code as *u32) = ubfx_instr
    rs @r11 = 32 - s
    back @r12 = T_SUBS_LDR
    *((code + 4) as *u32) = back
    d @r12 = *(orr_table + rs * 4)
    d2 @r7 = *(orr_table + s * 4)
    d += ORR_LSR_R4
    *((code + 8) as *u32) = d
    // orr r3, r3, r4, lsl #s
    d2 += 0x01000000
    stm @r12 = T_STMIA_R3
    d2 += 0x00010000
    *(code + 18) = stm
    d2 += 1
    *((code + 12) as *u32) = d2
    slot = code + 16
    code += 20
    #(n -= 1)
    if #ne goto glyph
    goto finish
}

// A text object: this header, then the text with text_add's kern codes,
// len bytes, padded to a word.
// Its height is FONT_HEIGHT. Use text_add to make one.
struct Text {
    vtable: *DisplayVtable
    x0: u16
    y0: u16
    x1: u16
    y1: u16
    // RGB565, fg | bg << 16
    colors: u32
    len: u32
    // of the whole text, in pixels; x1 may clip it
    width: u32
    // the most bytes of code text_start can generate, from text_code_size
    code_size: u32
    // Set by text_start: the scratch block, which holds the pixel pairs,
    // the row's bits and then the code; and the y the bits were made for.
    // The pairs are the RGB565 pixels for each 2 bits n of a row, first
    // pixel in the low half, a 1 bit being the foreground: bg bg, fg bg,
    // bg fg and fg fg.
    scratch: *u32
    bits: *u32
    code: *u8
    row_y: u32
}

#[link_section = ".ram"]
static text_vtable = DisplayVtable {
    render: text_render,
    start: text_start,
    end: text_end,
}

// Allocate the scratch block and compile the text. If there's no room, scratch is 0, and the text renders as its
// background color.
#[link_section = ".ram"]
fn text_start(self: *Text) {
    push(r4, r5, r6, lr)
    self @r4 = self
    width @r1 = self.width
    // the bits, plus a word that the funnel shift in text_render reads
    words @r5 = width + 31
    words >>= 5
    // the pairs, the bits, and the code
    size @r0 = self.code_size
    words += 1
    size += 16
    size += words << 2
    addr @r0 = call pico_alloc(size)
    scratch @r0 = addr as *u32
    self.scratch = scratch
    if scratch == 0 goto done
    // fg bg is colors itself
    colors @r3 = self.colors
    bg @r2 = colors >> 16
    pair0 @r2 = pkhbt(bg, bg << 16)
    pair2 @r12 = ror(colors, 16)
    fg @lr = colors[0..16]
    pair3 @lr = pkhbt(fg, fg << 16)
    pair1 @r3 = colors
    *scratch = (pair0, pair1, pair2, pair3)
    bits @r0 = scratch + 16
    self.bits = bits
    code @r5 = bits + (words << 2)
    text @r1 = self as *u8
    text += size(Text)
    len @r2 = self.len
    arg @r0 = code
    call jit_text(arg, text, len)
    code += 1
    self.code = code
    none @r0 = -1
    self.row_y = none
    // the code is fetched from RAM that was just written
    dsb
    isb
done:
    pop(r4, r5, r6, pc)
}

#[link_section = ".ram"]
fn text_end(self: *Text) {
    p @r0 = self.scratch
    #[tail] call pico_free(p)
}

// Render the span x0..x1 of line y. The first span of a line runs the
// generated code to make the row's bits; then each span expands its bits
// to pixels, 2 bits at a time, with the object's pixel pairs.
#[link_section = ".ram"]
fn text_render(self: *Text, y: u32, x1x0: u32, buf: *u16) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    self @r5 = self
    x1x0 @r6 = x1x0
    buf @r7 = buf
    scratch @r4 = self.scratch
    row_y @r0 = self.row_y
    // too far for cbz
    obj_x0 @r9 = self.x0
    #(scratch - 0)
    if #eq goto no_scratch
    pairs @r8 = scratch
    #(y - row_y)
    if {
        if #eq goto end
        self.row_y = y
        y0 @r2 = self.y0
        stride @r3 = FONT_STRIDE
        row @r0 = &font_bits
        dy @r2 = y - y0
        row += dy * stride
        bits @r1 = self.bits
        code @r2 = self.code
        // uses r0-r4
        blx code
    }

    x0 @r0 = x1x0[0..16]
    x1 @r1 = x1x0 >> 16
    // one pixel first if x0 is odd, so dst is word aligned
    #(x0 & 1)
    n @r10 = x1 - x0
    bit @r2 = x0 - obj_x0
    dst @r7 = buf + (x0 << 1)
    bits @r3 = self.bits
    if {
        if #eq goto end
        word_ix @r1 = bit >> 5
        word @r1 = *(bits + word_ix * 4)
        bit_shift @r4 = bit & 31
        word >>= bit_shift
        lobit @r1 = word & 1
        pix @r1 = *((pairs + lobit * 4) as *u16)
        bit += 1
        *dst++ = pix
        n -= 1
    }
    // Funnel shift: each window of 32 bits starting at bit is
    // (cur >> shift) | (next << (32 - shift)), where cur and next are
    // successive words of bits. With shift = 0, the shift by 32 gives 0.
    // 32 pixels at a time; n is biased by -32
    word_ix @r1 = bit >> 5
    #(n -= 32)
    src @r9 = bits + (word_ix << 2)
    shift @r11 = bit & 31
    cur @lr = *src
    rshift @r12 = 32 - shift
    dst32 @r7 = dst as *u32
    // the first window
    next @r4 = *(src + 4)
    lo @r5 = cur >> shift
    src += 4
    cur = next
    hi @r4 = next << rshift
    window @r6 = lo | hi
    if #lo goto tail
    // Each group of 8 pixels extracts four 2 bit fields, loads their pairs,
    // and stores them. Between the last load and the store goes a step
    // toward the next window.
    loop {
        f0 @r0 = window[0..2]
        f1 @r1 = window[2..4]
        f2 @r2 = window[4..6]
        f3 @r3 = window[6..8]
        q0 @r0 = *(pairs + f0 * 4)
        q1 @r1 = *(pairs + f1 * 4)
        q2 @r2 = *(pairs + f2 * 4)
        q3 @r3 = *(pairs + f3 * 4)
        *dst32++ = (q0, q1, q2, q3)
        f0 @r0 = window[8..10]
        f1 @r1 = window[10..12]
        f2 @r2 = window[12..14]
        f3 @r3 = window[14..16]
        q0 @r0 = *(pairs + f0 * 4)
        q1 @r1 = *(pairs + f1 * 4)
        q2 @r2 = *(pairs + f2 * 4)
        q3 @r3 = *(pairs + f3 * 4)
        lo @r5 = cur >> shift
        *dst32++ = (q0, q1, q2, q3)
        f0 @r0 = window[16..18]
        f1 @r1 = window[18..20]
        f2 @r2 = window[20..22]
        f3 @r3 = window[22..24]
        q0 @r0 = *(pairs + f0 * 4)
        q1 @r1 = *(pairs + f1 * 4)
        q2 @r2 = *(pairs + f2 * 4)
        q3 @r3 = *(pairs + f3 * 4)
        cur = *(src + 4)
        *dst32++ = (q0, q1, q2, q3)
        f0 @r0 = window[24..26]
        f1 @r1 = window[26..28]
        f2 @r2 = window[28..30]
        f3 @r3 = window[30..32]
        q0 @r0 = *(pairs + f0 * 4)
        q1 @r1 = *(pairs + f1 * 4)
        q2 @r2 = *(pairs + f2 * 4)
        q3 @r3 = *(pairs + f3 * 4)
        hi @r4 = cur << rshift
        window @r6 = lo | hi
        src += 4
        #(n -= 32)
        *dst32++ = (q0, q1, q2, q3)
        if #hs goto loop
    }

tail:
    // The last 0 to 31 pixels, all in window. rem is the pixels
    // left, biased by -4: n + 28 carries when at least 4 are left.
    #(rem @r1 = n + 28)
    f0 @r4 = window[0..2]
    if #lo goto last_few
    loop {
        f1 @r3 = window[2..4]
        q0 @r2 = *(pairs + f0 * 4)
        q1 @r3 = *(pairs + f1 * 4)
        window >>= 4
        #(rem -= 4)
        f0 @r4 = window[0..2]
        *dst32++ = (q0, q1)
        if #hs goto loop
    }
last_few:
    // with the bias, the low two bits of rem are the pixels left
    q0 @r2 = *(pairs + f0 * 4)
    #(_ @r3 = rem >> 2)
    if #cc goto single
    window >>= 2
    *dst32++ = q0
single:
    f0 @r4 = window & 1
    #(_ @r1 = rem >> 1)
    if #cc goto done
    pix @r2 = *((pairs + f0 * 4) as *u16)
    *(dst32 as *u16) = pix
    nop
done:
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)

no_scratch:
    x0 @r0 = x1x0[0..16]
    x1 @r2 = x1x0 >> 16
    count @r2 = x1 - x0
    // fill_16 only looks at the low half
    colors @r1 = self.colors
    color @r1 = colors >> 16
    dst @r0 = buf + (x0 << 1)
    pop(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    #[tail] call fill_16(dst, color, count)
}

// Measure the first n of the len (at least 1) characters at s, as text_add
// sets them, where n stops short of the first character that would start
// at or past room. Returns n, their width in pixels and the number of kern
// codes between them. The width is their advances, less their kerns, plus
// what the first glyph extends left of its origin.
//
// A pair kerns by the number of bits set in both the first's right byte in
// font_kern and the second's left byte. For the 8 bits of x, x * 0x08040201
// has copies at bits 0, 9, 18 and 27, so that shifted right by 3 they put
// one each of the 8 bits at bits 0, 4, ... 28, and multiplying those by
// 0x11111111 adds them in the top 4 bits.
#[align = 4]
fn text_measure(s: *u8, len: u32, room: u32) -> (n: u32, width: u32, kerns: u32) {
    push(r4, r5, r6, r7, r8, r9, r10, r11, lr)
    glyphs @r3 = &font_glyphs
    glyphs -= FONT_FIRST * 4
    c @r12 = *s
    g @r12 = *(glyphs + c * 4)
    total @r4 = 0
    left @r12 = (g as i32)[16..20]
    #(left - 0)
    if #lt {
        total -= left
    }
    // glyph advances, in the high bytes of font_glyphs
    advs @r3 = (glyphs + 3) as *u8
    kern_t @r5 = &font_kern
    kern_t -= FONT_FIRST * 2
    spread @r6 = 0x08040201
    sum @r7 = 0x11111111
    // the last character's right byte
    right @r8 = 0
    count @r9 = 0
    p @r10 = s
    end @r1 = s + len
    loop {
        c @r12 = *p
        pair @lr = *(kern_t + c * 2)
        w @r11 = *(advs + c * 4)
        t @r12 = right & pair
        right = pair >> 8
        t = t * spread
        t = sum & (t >> 3)
        t = t * sum
        k @r12 = t >> 28
        // where c starts
        start @lr = total - k
        #(start - room)
        if #hs goto break
        total = start + (w >> 2)
        #(k - 0)
        if #ne {
            count += 1
        }
        p += 1
        #(p - end)
        if #ne goto loop
    }
    n = p - s
    width = total
    kerns = count
    pop(r4, r5, r6, r7, r8, r9, r10, r11, pc)
}

// The most bytes jit_text can need, room included, for the n (at least 1)
// characters at s as text_add stores them. That's 10 for each glyph with
// pixels, 10 more for each that can start in the output word before the one
// in r2, 4 for each word boundary, which a straddle or a store passes, and
// 8 for the start, the tail and the room. A glyph can only start behind
// the word in r2 if it starts left of where earlier glyphs' pixels end,
// since that word moves past a glyph's start only for pixels that reach
// past it.
fn text_code_size(s: *u8, n: u32) -> size {
    push(r4, r5, r6, lr)
    glyphs @r2 = &font_glyphs
    glyphs -= FONT_FIRST * 4
    c @r12 = *s
    g @r12 = *(glyphs + c * 4)
    pen @r3 = 0
    left @r12 = (g as i32)[16..20]
    #(left - 0)
    if #lt {
        pen -= left
    }
    // where the pixels so far end
    reach @r4 = 0
    total @r5 = 8
    loop {
        c @r12 = *s++
        g @r12 = *(glyphs + c * 4)
        width @r6 = g[20..26]
        if {
            if width != 0 goto else
            // signed: a kern code moves back
            pen += (g as i32) >> 26
            goto end
        } else {
            left @lr = (g as i32)[16..20]
            start @lr = pen + left
            total += 10
            #(start - reach)
            if #lt {
                total += 10
            }
            ink @lr = start + width
            #(ink - reach)
            if #gt {
                reach = ink
            }
            pen += g >> 26
        }
        #(n -= 1)
        if #ne goto loop
    }
    // the boundaries, at most one for each 32 pixels of output
    #(pen - reach)
    if #gt {
        reach = pen
    }
    words @r4 = reach >> 5
    size = total + (words << 2)
    pop(r4, r5, r6, pc)
}

// The width in pixels of the len characters at s, as text_add sets them.
fn text_width(s: *u8, len: u32) -> result {
    if len == 0 goto empty
    push(r4, lr)
    room @r2 = -1
    (n @r0, width @r1, kerns @r2) = call text_measure(s, len, room)
    result = width
    pop(r4, pc)
empty:
    result = 0
    bx lr
}

// Append a text object to list, for the len characters at s, at x, y
// (packed as x | y << 16) in colors fg | bg << 16. The text is cut off at
// the right edge of the screen, and kerned: a kerned pair gets a kern code
// between, a blank that moves back by the kern. Called from thread mode.
fn text_add(list: *DisplayList, xy: u32, colors: u32, s: *u8, len: u32) {
    // r10 keeps sp 8 byte aligned for dl_alloc
    push(r4, r5, r6, r7, r8, r9, r10, lr)
    list @r4 = list
    xy @r5 = xy
    colors @r6 = colors
    s @r7 = s
    // the fifth argument, on the stack
    len @r1 = sp.len
    #(len - 0)
    if #eq goto done
    // The characters that are at least partly on screen
    x0 @r2 = xy[0..16]
    room @r2 = H_ACTIVE - x0
    arg @r0 = s
    (n @r0, width @r1, kerns @r2) = call text_measure(arg, len, room)
    #(n - 0)
    if #eq goto done
    len @r9 = n
    width @r8 = width
    kerns @r10 = kerns
    l @r0 = list
    sz @r1 = len + kerns
    sz += size(Text) + 3
    sz &= !3
    block @r0 = call dl_alloc(l, sz)
    obj @r0 = block as *Text
    #(obj - 0)
    if #eq goto done
    vt @r1 = &text_vtable
    obj.vtable = vt
    x @r1 = xy[0..16]
    obj.x0 = x
    y @r2 = xy >> 16
    obj.y0 = y
    x1 @r3 = x + width
    room @r12 = H_ACTIVE
    #(x1 - room)
    if #hi {
        x1 = room
    }
    obj.x1 = x1
    y += FONT_HEIGHT
    obj.y1 = y
    obj.colors = colors
    total @r1 = len + kerns
    obj.len = total
    obj.width = width
    obj @r10 = obj
    // Copy the text, kerning as text_measure does. Kern code FONT_KERN - k
    // moves back k pixels.
    dst @r1 = obj as *u8
    dst += size(Text)
    kern_t @r4 = &font_kern
    kern_t -= FONT_FIRST * 2
    spread @r5 = 0x08040201
    sum @r6 = 0x11111111
    right @r8 = 0
    loop {
        c @r0 = *s++
        pair @r3 = *(kern_t + c * 2)
        t @r12 = right & pair
        right = pair >> 8
        t = t * spread
        t = sum & (t >> 3)
        t = t * sum
        #(k @r12 = t >> 28)
        if #ne {
            code @r12 = FONT_KERN - k
            *dst++ = code
        }
        *dst++ = c
        #(len -= 1)
        if #ne goto loop
    }
    text @r0 = obj as *u8
    text += size(Text)
    n @r1 = obj.len
    size @r0 = call text_code_size(text, n)
    obj.code_size = size
done:
    pop(r4, r5, r6, r7, r8, r9, r10, pc)
}
