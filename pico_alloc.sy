// A really tiny bitmap allocator, suitable for renderer temporaries.

// 31 blocks keeps the masks, such as the initial free mask
// (1 << N_BLOCKS) - 1, within a word without special cases.
const N_BLOCKS = 31
const LOG_BLOCK_SIZE = 8
const BLOCK_SIZE = 1 << LOG_BLOCK_SIZE
static mut pico_heap: [u32; N_BLOCKS * BLOCK_SIZE / 4]
// free mask is last
static mut pico_masks: [u32; N_BLOCKS + 1]

// Must be called before first allocation
#[link_section = ".ram"]
fn pico_reset() {
    masks @r0 = &pico_masks
    free @r1 = (1 << N_BLOCKS) - 1
    *(masks + N_BLOCKS * 4) = free
    bx lr
}

// Assumes size != 0
#[link_section = ".ram"]
fn pico_alloc(size: u32) {
    masks @r1 = &pico_masks
    size -= 1
    mask @r3 = 2
    #(size >>= LOG_BLOCK_SIZE)
    free @r2 = *(masks + N_BLOCKS * 4)
    if {
        if #eq goto end
        mask <<= size
        loop {
            #(size -= 1)
            free &= free >> 1
            if #ne goto loop
        }
    }
    mask -= 1
    if {
        if free == 0 goto end
        free = rbit(free)
        ix @r2 = clz(free)
        free @r0 = *(masks + N_BLOCKS * 4)
        mask <<= ix
        free &= !mask
        *(masks + N_BLOCKS * 4) = free
        heap @r0 = &pico_heap
        *(masks + ix * 4) = mask
        addr @r0 = heap + (ix << LOG_BLOCK_SIZE)
    }
    bx lr
}

#[link_section = ".ram"]
fn pico_free(p: *u8) {
    heap @r1 = &pico_heap
    masks @r2 = &pico_masks
    #(p -= heap)
    if {
        if #lo goto end
        ix @r0 = p >> LOG_BLOCK_SIZE
        free @r1 = *(masks + N_BLOCKS * 4)
        mask @r3 = *(masks + ix * 4)
        free |= mask
        *(masks + N_BLOCKS * 4) = free
    }
    bx lr
}
