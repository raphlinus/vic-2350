// A really tiny bitmap allocator, suitable for renderer temporaries.

const N_BLOCKS = 16
const LOG_BLOCK_SIZE = 7
const BLOCK_SIZE = 1 << LOG_BLOCK_SIZE
static mut pico_free_mask: u32 = (1 << N_BLOCKS) - 1
static mut pico_heap: [u32; N_BLOCKS * BLOCK_SIZE / 4]
static mut pico_masks: [u32; N_BLOCKS]

// Assumes size != 0
#[link_section = ".ram"]
fn pico_alloc(size: u32) {
    pfree @r1 = &pico_free_mask
    size -= 1
    mask @r3 = 2
    #(size >>= LOG_BLOCK_SIZE)
    free @r2 = *pfree
    if {
        if #eq goto end
        mask <<= size
        loop {
            #(size -= 1)
            free &= free >> 1
            if #ne goto loop
        }
    }
    mask -= 1
    if {
        if free == 0 goto end
        free = rbit(free)
        ix @r2 = clz(free)
        free @r0 = *pfree
        mask <<= ix
        free &= !mask
        *pfree = free
        masks @r0 = &pico_masks
        heap @r1 = &pico_heap
        *(masks + ix * 4) = mask
        addr @r0 = heap + (ix << LOG_BLOCK_SIZE)
    }
    bx lr
}

#[link_section = ".ram"]
fn pico_free(p: *u8) {
    heap @r1 = &pico_heap
    pfree @r3 = &pico_free_mask
    p -= heap
    ix @r0 = p >> LOG_BLOCK_SIZE
    masks @r2 = &pico_masks
    free @r1 = *pfree
    mask @r2 = *(masks + ix * 4)
    free |= mask
    *pfree = free
    bx lr
}
