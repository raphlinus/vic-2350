// Draw line y of the tile map, 16 pixels per tile: the tile's row is two
// words of 4bpp pixels, and each byte looks up two RGB555 pixels in the
// tile's 1 KB fast palette. The tile data, palettes and map are in
// tiles.sy, generated by tools/tiles.py, and live in RAM. y is preserved,
// for dvi_release_line.
//
// Not currently wired up, but we had it running in a previous version.
fn render_line_tiles(y: u32, pixels: *u32) {
    push(r4, r5, r6, r7)
    row @r2 = y >> 4
    stride @r3 = MAP_W * 8
    off @r2 = row * stride
    map @r3 = &tile_map
    map += off
    row_off @r4 = y[0..4]
    row_off <<= 3
    n @r12 = MAP_W
    loop {
        (tile @r5, pal @r6) = *map++
        tile += row_off
        (w0 @r5, w1 @r7) = *tile
        b0 @r2 = w0[0..8]
        p0 @r2 = *(pal + b0 * 4)
        *pixels++ = p0
        b1 @r2 = w0[8..16]
        p1 @r2 = *(pal + b1 * 4)
        *pixels++ = p1
        b2 @r2 = w0[16..24]
        p2 @r2 = *(pal + b2 * 4)
        b3 @r5 = w0 >> 24
        p3 @r5 = *(pal + b3 * 4)
        *pixels++ = (p2, p3)
        b4 @r2 = w1[0..8]
        p4 @r2 = *(pal + b4 * 4)
        b5 @r5 = w1[8..16]
        p5 @r5 = *(pal + b5 * 4)
        *pixels++ = (p4, p5)
        b6 @r2 = w1[16..24]
        p6 @r2 = *(pal + b6 * 4)
        b7 @r5 = w1 >> 24
        #(n -= 1)
        p7 @r5 = *(pal + b7 * 4)
        *pixels++ = (p6, p7)
        if #ne goto loop
    }
    pop(r4, r5, r6, r7)
    bx lr
}
