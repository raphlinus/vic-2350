// A minimal program that can blink the LED on a Fruit Jam board.
// It requires .vectors and .image_def sections.

symbol _data_source: *u32
symbol _data_start: *u32
symbol _data_size_words: u32
symbol _bss_start: *u32
symbol _bss_size_words: u32

fn start() {
    // initialize RAM
    src @r0 = _data_source
    dst @r1 = _data_start
    count @r2 = lower16(_data_size_words)
data_loop:
    #(count -= 1)
    val @r3 = *src; src += 4
    *dst = val; dst += 4
    bne data_loop

    count @r3 = lower16(_bss_size_words)
    dst = _bss_start
    zero @r2 = count // elided
bss_loop:
    #(count -= 1)
    *dst = zero; dst += 4
    bne bss_loop

    mask @r0 = 0xc
    bl assert_reset
    // TODO: clock setup

    mask @r0 = 0x240
    bl clear_reset
    pads_bank0 @r0 = peripherals.PADS_BANK0
    pads_bank0 += 4
    led_pin @r1 = 29
    config @r2 = 0x56
    *(pads_bank0 + (led_pin << 2)) = config
    io_bank0 @r0 = peripherals.IO_BANK0
    io_bank0 += 4
    function @r2 = 5
    *(io_bank0 + (led_pin << 3)) = function
    sio @r0 = peripherals.SIO
    mask @r2 = 1
    mask = mask << led_pin
    sio.GPIO_OE_SET = mask
blink_loop:
    sio.GPIO_OUT_XOR = mask
    count @r1 = 300_000
delay:
    #(count -= 1)
    bne delay
    b blink_loop
}

fn assert_reset(mask: u32) {
    resets @r1 = peripherals.RESETS
    atomic_set @r2 = 0x2000
    *(resets + atomic_set) = mask
    bx lr
}

fn clear_reset(mask: u32) {
    resets @r1 = peripherals.RESETS
    atomic_clear @r2 = 0x3000
    *(resets + atomic_clear) = mask
loop:
    status @r2 = resets.RESET_DONE
    #(_ @r2 = mask & !status)
    bne loop
    bx lr
}
