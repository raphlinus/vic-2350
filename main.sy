// Bring up the 12 MHz crystal and run clk_sys from PLL_SYS at 126 MHz, then
// generate a 640x480 DVI signal with HSTX. Two chained DMA channels feed
// HSTX: channel 0 sends each line's horizontal sync, channel 1 its content,
// either blanking or a line of pixels. A DMA interrupt reprograms the
// channel that just finished, and hands line buffers to the renderer, which
// runs in thread mode and gets them with dvi_get_line. This follows the
// main branch of pico-dvi-rs, without audio. The LED toggles every 30
// frames. The .image_def and .vectors are in startup.s.

symbol _data_source: *u32
symbol _data_start: *u32
symbol _data_size_words: u32
symbol _bss_start: *u32
symbol _bss_size_words: u32

// 640x480 at 60 Hz
const H_FRONT_PORCH = 16
const H_SYNC_WIDTH = 96
const H_BACK_PORCH = 48
const H_ACTIVE = 640
const V_FRONT_PORCH = 10
const V_SYNC_WIDTH = 2
const V_BACK_PORCH = 33
const V_ACTIVE = 480
const V_SYNC_START = V_FRONT_PORCH
const V_SYNC_END = V_SYNC_START + V_SYNC_WIDTH
const V_ACTIVE_START = V_SYNC_END + V_BACK_PORCH
const V_TOTAL = V_ACTIVE_START + V_ACTIVE

// HSTX commands
const HSTX_RAW = 0 << 12
const HSTX_RAW_REPEAT = 1 << 12
const HSTX_TMDS = 2 << 12
const HSTX_TMDS_REPEAT = 3 << 12

// TMDS control symbols for lane 0, indexed by (vsync, hsync), where 1 is
// inactive (both polarities are negative). Lanes 1 and 2 send 00.
const TMDS_CTRL_00 = 0x354
const TMDS_CTRL_01 = 0x0ab
const TMDS_CTRL_10 = 0x154
const TMDS_CTRL_11 = 0x2ab
const SYNC_V0_H0 = TMDS_CTRL_00 | (TMDS_CTRL_00 << 10) | (TMDS_CTRL_00 << 20)
const SYNC_V0_H1 = TMDS_CTRL_01 | (TMDS_CTRL_00 << 10) | (TMDS_CTRL_00 << 20)
const SYNC_V1_H0 = TMDS_CTRL_10 | (TMDS_CTRL_00 << 10) | (TMDS_CTRL_00 << 20)
const SYNC_V1_H1 = TMDS_CTRL_11 | (TMDS_CTRL_00 << 10) | (TMDS_CTRL_00 << 20)

// Sync words at the end of each command list are sent raw rather than
// repeated, as in pico-dvi-rs.
const TAIL = 8

// HSTX command lists, read by DMA. Channel 0 sends the horizontal sync
// pulse, from the end of one line's active pixels to the start of the
// next's.
static mut sync_pulse_vsync_off: [u32; 15] = [
    HSTX_RAW_REPEAT | H_FRONT_PORCH, SYNC_V1_H1,
    HSTX_RAW_REPEAT | H_SYNC_WIDTH, SYNC_V1_H0,
    HSTX_RAW_REPEAT | (H_BACK_PORCH - TAIL), SYNC_V1_H1,
    HSTX_RAW | TAIL,
    SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1,
    SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1,
]
static mut sync_pulse_vsync_on: [u32; 15] = [
    HSTX_RAW_REPEAT | H_FRONT_PORCH, SYNC_V0_H1,
    HSTX_RAW_REPEAT | H_SYNC_WIDTH, SYNC_V0_H0,
    HSTX_RAW_REPEAT | (H_BACK_PORCH - TAIL), SYNC_V0_H1,
    HSTX_RAW | TAIL,
    SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1,
    SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1,
]

// Channel 1 sends a line's content: blanking outside the active lines,
// a line buffer, or err_line if the renderer didn't finish in time.
static mut line_only_vsync_off: [u32; 11] = [
    HSTX_RAW_REPEAT | (H_ACTIVE - TAIL), SYNC_V1_H1,
    HSTX_RAW | TAIL,
    SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1,
    SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1, SYNC_V1_H1,
]
static mut line_only_vsync_on: [u32; 11] = [
    HSTX_RAW_REPEAT | (H_ACTIVE - TAIL), SYNC_V0_H1,
    HSTX_RAW | TAIL,
    SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1,
    SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1, SYNC_V0_H1,
]
// Red, in RGB555
const ERR_PIXELS = 0x7c007c00
static mut err_line: [u32; 11] = [
    HSTX_TMDS_REPEAT | (H_ACTIVE - 2 * TAIL), ERR_PIXELS,
    HSTX_TMDS | (2 * TAIL),
    ERR_PIXELS, ERR_PIXELS, ERR_PIXELS, ERR_PIXELS,
    ERR_PIXELS, ERR_PIXELS, ERR_PIXELS, ERR_PIXELS,
]

// Two line buffers, each an HSTX command followed by 640 RGB555 pixels.
// The command word is stored at startup.
const LINE_WORDS = 1 + H_ACTIVE / 2
const N_LINES = 2
static mut video_lines: [[u32; LINE_WORDS]; N_LINES]
const LINE_BYTES = size(video_lines) / N_LINES
static mut line_ptrs: [*u32; N_LINES] = [&video_lines, &video_lines + LINE_BYTES]

// The state of one line buffer
struct LineState {
    // lent to the renderer
    lent: u32
    // still lent when its next line was due, so that line shows err_line
    missed: u32
}

const QUEUE_SIZE = 4

struct Dvi {
    // First, so a buffer's state is at p + ix * 8
    lines: [LineState; N_LINES]
    // The line the next interrupts set up, 0 at the start of the front
    // porch. Starts at 1, since line 0 is set up before DMA starts.
    v_ctr: u32
    // The channel that will finish next
    dma_pong: u32
    frame_count: u32
    // Line numbers handed to the renderer, a single producer single
    // consumer queue written by the interrupt
    queue_rd: u32
    queue_wr: u32
    queue: [u32; QUEUE_SIZE]
}

static mut dvi: Dvi

// One DMA channel's registers; channels are 0x40 apart.
struct DmaChannel {
    read_addr: u32
    write_addr: u32
    trans_count: u32
    ctrl_trig: u32
    al1_ctrl: u32
}

fn start() {
    // initialize RAM
    src @r0 = _data_source
    dst @r1 = _data_start
    count @r2 = lower16(_data_size_words)
    loop {
        #(count -= 1)
        val @r3 = *src++
        *dst++ = val
        if #ne goto loop
    }

    // count is zero after the loop
    zero @r2 = count // elided
    count @r1 = lower16(_bss_size_words)
    dst @r0 = _bss_start
    loop {
        #(count -= 1)
        *dst++ = zero
        if #ne goto loop
    }

    // reset DMA and HSTX
    mask @r0 = (1 << 2) | (1 << 3)
    bl assert_reset

    bl configure_clk_sys1
    bl init_xosc
    bl init_pll
    bl configure_clk_ref
    bl configure_clk_sys2

    // release reset for BUSCTRL, IO_BANK0 and PADS_BANK0
    mask @r0 = (1 << 1) | (1 << 6) | (1 << 9)
    bl reset

    // set up pad: 4mA, pull-down, Schmitt input
    pads_bank0 @r0 = peripherals.PADS_BANK0
    pads_bank0 += 4
    led_pin @r1 = 7
    config @r2 = 0x56
    *(pads_bank0 + (led_pin << 2)) = config

    // function 5 is SIO
    io_bank0 @r0 = peripherals.IO_BANK0
    io_bank0 += 4
    function @r1 = 5
    led_pin @r2 = 7
    *(io_bank0 + (led_pin << 3)) = function

    sio @r0 = peripherals.SIO
    led_mask @r1 = 1 << 7
    sio.GPIO_OE_SET = led_mask

    // DMA gets priority on the bus, so the CPU can't starve HSTX
    busctrl @r0 = peripherals.BUSCTRL
    priority @r1 = (1 << 8) | (1 << 12)
    busctrl.BUS_PRIORITY = priority

    bl dvi_init

    bl configure_clk_hstx
    // release reset for DMA and HSTX
    mask @r0 = (1 << 2) | (1 << 3)
    bl reset
    bl setup_hstx
    bl setup_dma

    // enable interrupts globally
    cpsie(i)

    // unmask DMA_IRQ_0
    nvic_iser0 @r2 = &peripherals.PPB.NVIC_ISER0
    irq @r3 = 1 << 10
    *nvic_iser0 = irq

    // start channel 0
    dma @r2 = peripherals.DMA
    chan @r3 = 1
    dma.MULTI_CHAN_TRIGGER = chan

    loop {
        bl dvi_get_line
        y @r0 = r0
        pixels @r1 = r1
        bl render_line
        bl dvi_release_line
        goto loop
    }
}

// Fill a line with a test pattern: red increases down the screen, blue
// decreases, and green ramps up every 128 lines. y is preserved, for
// dvi_release_line.
fn render_line(y: u32, pixels: *u32) {
    push(r4, r5, r6, r7)
    red @r4 = y >> 4
    c @r5 = red << 10
    // green before blue, so the shifted orr's result isn't needed by the
    // next instruction
    green @r6 = y[2..7]
    c |= green << 5
    blue @r6 = red ^ 31
    c |= blue
    // two pixels per word; pkhbt takes one cycle, orr with a shift two
    c = pkhbt(c, c << 16)
    c0 @r4 = c
    c2 @r6 = c
    c3 @r7 = c
    n @r2 = H_ACTIVE / 8
    loop {
        // decrement first, so the flags are ready for the branch
        #(n -= 1)
        *pixels++ = (c0, c, c2, c3)
        if #ne goto loop
    }
    pop(r4, r5, r6, r7)
    bx lr
}

// Store the HSTX command at the start of each line buffer, and set the
// line counter.
fn dvi_init() {
    lines @r0 = &video_lines
    cmd @r1 = HSTX_TMDS | H_ACTIVE
    *lines = cmd
    *(lines + LINE_BYTES) = cmd
    p @r0 = &dvi
    one @r1 = 1
    p.v_ctr = one
    bx lr
}

// Wait for the next line to render. Returns its number y in r0 and a
// pointer to its pixels in r1, which belong to the caller until
// dvi_release_line(y).
fn dvi_get_line() {
    p @r3 = &dvi
    rd @r0 = p.queue_rd
    loop {
        wr @r1 = p.queue_wr
        #(rd - wr)
        if #ne goto end
        // The interrupt that fills the queue does sev, so a push between
        // the check and the wfe isn't missed.
        wfe
        goto loop
    }
    queue @r1 = &p.queue
    y @r2 = *(queue + rd * 4)
    rd += 1
    rd &= QUEUE_SIZE - 1
    p.queue_rd = rd
    ptrs @r1 = &line_ptrs
    ix @r0 = y & 1
    pixels @r1 = *(ptrs + ix * 4)
    // skip the HSTX command
    pixels += 4
    y_out @r0 = y
    bx lr
}

// Give line y's buffer back, for the interrupt to send.
fn dvi_release_line(y: u32) {
    p @r1 = &dvi
    ix @r0 = y & 1
    line @r1 = (p + ix * 8) as *LineState
    zero @r2 = 0
    line.lent = zero
    bx lr
}

fn default_handler() {
    loop {
        goto loop
    }
}

fn init_xosc() {
    xosc @r0 = peripherals.XOSC
    startup @r1 = xosc.STARTUP
    // ~64ms startup delay
    startup_delay @r2 = 3000
    startup[0..14] = startup_delay
    xosc.STARTUP = startup
    ctrl @r1 = xosc.CTRL
    // enable, 1_15MHz
    ctrl_val @r2 = 0xfabaa0
    ctrl[0..24] = ctrl_val
    xosc.CTRL = ctrl
    // wait for stable bit
    loop {
        status @r1 = xosc.STATUS
        #(status & status)
        if #pl goto loop
    }
    bx lr
}

fn init_pll() {
    push(lr)
    mask @r0 = 1 << 14
    bl reset
    pll @r0 = peripherals.PLL_SYS
    // VCO = 12 MHz * 126 = 1512 MHz
    fbdiv @r1 = pll.FBDIV_INT
    fbdiv_val @r2 = 126
    fbdiv[0..12] = fbdiv_val
    pll.FBDIV_INT = fbdiv
    // turn on pll and pll vco: clear PD and VCOPD in PWR
    pwr_bits @r1 = (1 << 5) | (1 << 0)
    pwr_clear @r3 = 0x3000 + 0x4
    *(pll + pwr_clear) = pwr_bits
    // wait for lock
    loop {
        cs @r1 = pll.CS
        #(cs & cs)
        if #pl goto loop
    }
    // 1512 / (2 * 6) = 126 MHz
    prim @r1 = pll.PRIM
    postdiv2 @r2 = 2
    prim[12..15] = postdiv2
    postdiv1 @r2 = 6
    prim[16..19] = postdiv1
    pll.PRIM = prim
    // clear POSTDIVPD
    pwr_bits @r1 = 1 << 3
    *(pll + pwr_clear) = pwr_bits
    pop(pc)
}

fn configure_clk_ref() {
    // select xosc as the source
    clocks @r0 = peripherals.CLOCKS
    ctrl @r1 = clocks.CLK_REF_CTRL
    src @r2 = 2
    ctrl[0..2] = src
    clocks.CLK_REF_CTRL = ctrl
    // wait for xosc to get selected
    loop {
        selected @r1 = clocks.CLK_REF_SELECTED
        selected = selected[0..4]
        #(selected - 4)
        if #ne goto loop
    }
    bx lr
}

// switch sys clock to ref and ref clock to rosc
fn configure_clk_sys1() {
    // select REF as the source
    clocks @r0 = peripherals.CLOCKS
    one @r1 = 1
    sys_ctrl_clear @r2 = 0x3000 + 0x3c
    *(clocks + sys_ctrl_clear) = one
    // wait for REF to get selected
    loop {
        selected @r3 = clocks.CLK_SYS_SELECTED
        #(selected >>= 1)
        if #cc goto loop
    }

    ctrl @r1 = clocks.CLK_REF_CTRL
    zero @r2 = 0
    ctrl[0..2] = zero
    clocks.CLK_REF_CTRL = ctrl
    // wait for rosc to get selected
    loop {
        selected @r1 = clocks.CLK_REF_SELECTED
        selected = selected[0..4]
        #(selected - 1)
        if #ne goto loop
    }
    bx lr
}

fn configure_clk_sys2() {
    clocks @r0 = peripherals.CLOCKS
    one @r1 = 1
    // set aux source to PLL
    ctrl @r3 = clocks.CLK_SYS_CTRL
    // select CLKSRC_PLL_SYS
    ctrl[5..8] = 0
    // CLKSRC_CLK_SYS_AUX
    ctrl[0..1] = one
    clocks.CLK_SYS_CTRL = ctrl
    // wait for AUX to get selected
    loop {
        selected @r1 = clocks.CLK_SYS_SELECTED
        #(selected >>= 2)
        if #cc goto loop
    }
    bx lr
}

// Take the blocks in mask out of reset and wait until they're ready.
fn reset(mask: u32) {
    resets @r1 = peripherals.RESETS
    atomic_clear @r2 = 0x3000
    *(resets + atomic_clear) = mask
    loop {
        status @r2 = resets.RESET_DONE
        #(_ @r2 = mask & !status)
        if #ne goto loop
    }
    bx lr
}

fn assert_reset(mask: u32) {
    resets @r1 = peripherals.RESETS
    atomic_set @r2 = 0x2000
    *(resets + atomic_set) = mask
    bx lr
}

fn configure_clk_hstx() {
    clocks @r0 = peripherals.CLOCKS
    ctrl @r1 = clocks.CLK_HSTX_CTRL
    // clk_sys
    ctrl[5..8] = 0
    clocks.CLK_HSTX_CTRL = ctrl
    // enable
    one @r2 = 1
    ctrl[11..12] = one
    clocks.CLK_HSTX_CTRL = ctrl
    bx lr
}

fn setup_hstx() {
    hstx @r0 = peripherals.HSTX_CTRL
    // setup for rgb 555
    tmds @r1 = 29 | (4 << 5) | (2 << 8) | (4 << 13) | (7 << 16) | (4 << 21)
    hstx.EXPAND_TMDS = tmds
    // This shifts a 32 bit word into 2 16 bit chunks.
    // For doubled pixels, better to set enc_shift to 0,
    // enc_n_shifts = number of pixel reps, and dma to 16 bit transfers
    shift @r1 = (1 << 8) | (16 << 16) | (2 << 24)
    hstx.EXPAND_SHIFT = shift
    csr @r1 = 3 | (2 << 8) | (5 << 16) | (5 << 28)
    *hstx = csr; hstx += 4
    // setup bits; feather is d2, clk, d1, d0 (pos)
    bit0 @r1 = 20 | (21 << 8)
    bit1 @r2 = bit0 | (1 << 16)
    *hstx = (bit0, bit1); hstx += 8
    bit2 @r1 = 1 << 17
    bit3 @r2 = bit2 | (1 << 16)
    *hstx = (bit2, bit3); hstx += 8
    bit4 @r1 = 10 | (11 << 8)
    bit5 @r2 = bit4 | (1 << 16)
    *hstx = (bit4, bit5); hstx += 8
    bit6 @r1 = 1 << 8
    bit7 @r2 = bit6 | (1 << 16)
    *hstx = (bit6, bit7); hstx += 8

    // pins 12..19 to function 0 (hstx), 4mA drive, Schmitt
    io_bank0 @r0 = peripherals.IO_BANK0
    // pin 12 = 8 * 12 + 4 - 8
    ctrl_offset @r2 = 92
    pad @r3 = 0x40038000 + 4 + 4 * 12
    loop {
        ctrl_offset += 8
        function @r1 = 0
        *(io_bank0 + ctrl_offset) = function
        pad_config @r1 = 0x16
        // pin 20 = 8 * 20 + 4 - 8
        #(ctrl_offset - 156)
        *pad = pad_config; pad += 4
        if #ne goto loop
    }
    bx lr
}

fn setup_dma() {
    ch @r0 = peripherals.DMA as *DmaChannel
    hstx_fifo @r1 = &peripherals.HSTX_FIFO.FIFO
    // 32 bit transfers, incrementing the read address, paced by HSTX
    // (DREQ 52), enabled
    ctrl @r2 = 0x680019

    // channel 0 starts with line 0's sync pulse and chains to channel 1
    cmds @r3 = &sync_pulse_vsync_off
    ch.read_addr = cmds
    ch.write_addr = hstx_fifo
    len @r3 = count(sync_pulse_vsync_off)
    ch.trans_count = len
    chain @r3 = ctrl | (1 << 13)
    ch.al1_ctrl = chain

    // channel 1 starts with line 0's blanking and chains to channel 0
    ch += 0x40
    cmds @r3 = &line_only_vsync_off
    ch.read_addr = cmds
    ch.write_addr = hstx_fifo
    len @r3 = count(line_only_vsync_off)
    ch.trans_count = len
    ch.al1_ctrl = ctrl

    dma @r0 = peripherals.DMA
    irqs @r1 = 3
    dma.INTS0 = irqs
    dma.INTE0 = irqs
    bx lr
}

// Runs from RAM, so flash access can't delay it.
#[link_section = ".ram"]
fn dma_irq_0_handler() {
    p @r0 = &dvi
    pong @r1 = p.dma_pong
    next @r2 = pong ^ 1
    p.dma_pong = next
    dma @r2 = peripherals.DMA
    bit @r3 = 1
    bit <<= pong
    dma.INTR = bit
    // the channel that just finished
    ch @r2 = (dma + (pong << 6)) as *DmaChannel
    v @r3 = p.v_ctr
    if pong != 0 goto line_done

    // Channel 0 finished line v - 1's sync pulse; set up line v's.
    cmds @r1 = &sync_pulse_vsync_off
    #(v - V_SYNC_START)
    if #lo goto set_sync
    #(v - V_SYNC_END)
    if #hs goto set_sync
    cmds = &sync_pulse_vsync_on
set_sync:
    ch.read_addr = cmds
    len @r1 = count(sync_pulse_vsync_off)
    ch.trans_count = len
    bx lr

    // Channel 1 finished line v - 1's content; set up line v's.
line_done:
    #(y @r1 = v - V_ACTIVE_START)
    if #lo goto blank
    ix @r1 = y & 1
    line @r12 = (p + ix * 8) as *LineState
    l @r0 = line.lent
    m @r12 = line.missed
    l |= m
    if l != 0 goto error
    ptrs @r0 = &line_ptrs
    cmds @r0 = *(ptrs + ix * 4)
    len @r1 = LINE_WORDS
    goto set_line
error:
    cmds @r0 = &err_line
    len @r1 = count(err_line)
    goto set_line
blank:
    cmds @r0 = &line_only_vsync_off
    #(v - V_SYNC_START)
    if #lo goto blank_set
    #(v - V_SYNC_END)
    if #hs goto blank_set
    cmds = &line_only_vsync_on
blank_set:
    len @r1 = count(line_only_vsync_off)
set_line:
    ch.read_addr = cmds
    ch.trans_count = len

    // Lend line v + 1's buffer to the renderer, unless it's still lent
    // from two lines ago, in which case that line shows err_line.
    p @r0 = &dvi
    #(y @r1 = v - (V_ACTIVE_START - 1))
    if #lo goto advance
    #(y - V_ACTIVE)
    if #hs goto advance
    ix @r2 = y & 1
    line @r12 = (p + ix * 8) as *LineState
    l @r2 = line.lent
    line.missed = l
    if l != 0 goto advance
    one @r2 = 1
    line.lent = one
    wr @r2 = p.queue_wr
    queue @r12 = &p.queue
    *(queue + wr * 4) = y
    wr += 1
    wr &= QUEUE_SIZE - 1
    p.queue_wr = wr
    sev

advance:
    v += 1
    // cmp can't encode V_TOTAL (525), but it can encode 524
    #(v - (V_TOTAL - 1))
    if {
        if #ls goto end
        v = 0
        frame @r1 = p.frame_count
        frame += 1
        #(frame - 30)
        if {
            if #ne goto end
            frame = 0
            sio @r2 = peripherals.SIO
            led_mask @r12 = 1 << 7
            sio.GPIO_OUT_XOR = led_mask
        }
        p.frame_count = frame
    }
    p.v_ctr = v
    bx lr
}
