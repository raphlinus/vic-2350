// Built alternately: one is rendered while the other is built.
static mut frame_lists: [DisplayList; 2]

fn demo_init() {
    push(r4, lr)
    bl stats_init
    bl init_alloc
    bl render_init
    pop(r4, pc)
}

// Each frame, move the rectangles, build a list in one of frame_lists,
// which the renderer isn't using, and swap it in.
fn demo_main() {
    list @r4 = &frame_lists as *DisplayList
    other @r5 = list + size(DisplayList)
    loop {
        l @r0 = list
        bl dl_clear

        l @r0 = list
        sz @r1 = size(Solid)
        bl dl_alloc
        obj @r0 = r0 as *u32
        if {
            if obj == 0 goto end
            vt @r1 = &solid_vtable
            zero @r2 = 0
            x1y1 @r3 = H_ACTIVE | (V_ACTIVE << 16)
            color @r12 = BG_COLOR
            *obj = (vt, zero, x1y1, color)
        }

        m @r6 = &movers as *Mover
        n @r7 = N_RECTS
        loop {
            l @r0 = list
            sz @r1 = size(Solid)
            bl dl_alloc
            obj @r0 = r0 as *u32
            if obj == 0 goto break
            obj @r8 = obj

            // Move, reversing at the edges. A position past either edge
            // is above the last valid one, as unsigned.
            x @r0 = m.x
            dx @r1 = m.dx
            w @r2 = m.w
            limit @r12 = H_ACTIVE
            nx @r3 = x + dx
            limit -= w
            #(nx - limit)
            if {
                if #ls goto end
                dx = -dx
                m.dx = dx
                nx = x + dx
            }
            m.x = nx
            x0 @r9 = nx
            x1 @r10 = nx + w

            y @r0 = m.y
            dy @r1 = m.dy
            h @r2 = m.h
            limit = V_ACTIVE
            ny @r3 = y + dy
            limit -= h
            #(ny - limit)
            if {
                if #ls goto end
                dy = -dy
                m.dy = dy
                ny = y + dy
            }
            m.y = ny

            vt @r0 = &solid_vtable
            x0y0 @r1 = pkhbt(x0, ny << 16)
            y1 @r3 = ny + h
            x1y1 @r2 = pkhbt(x1, y1 << 16)
            color @r3 = m.color
            *obj = (vt, x0y0, x1y1, color)
            m += size(Mover)
            #(n -= 1)
            if #ne goto loop
        }

        l @r0 = list
        bl dl_finish
        l @r0 = list
        bl render_swap
        t @r0 = list
        list = other
        other = t
        goto loop
    }
}
