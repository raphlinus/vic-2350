// Animated rectangles: a background and N_RECTS overlapping rectangles of
// various sizes that bounce around the screen, built into a new display
// list each frame.

const N_RECTS = 64
const BG_COLOR = 0x2104

// A rectangle's position, velocity and size. Velocities are signed,
// stored as u32.
struct Mover {
    x: u32
    y: u32
    dx: u32
    dy: u32
    w: u32
    h: u32
    color: u32
}

