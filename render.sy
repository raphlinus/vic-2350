use "vec.sy"
use "pico_alloc.sy"

// In fill.sy, which is assembled on its own
symbol fill_16: fn(dst: *u16, color, count)

// The main renderer

// A list of draw objects: the objects concatenated in draw order in
// payload, and the word offset of each in heads, sorted by y0. Lists are
// built in thread mode with display_list.sy.
struct DisplayList {
    payload: Vec
    heads: Vec
}

struct RenderState {
    // The list being rendered
    list: *DisplayList
    y: u32
    display_head_ix: u32
    active: *ActiveEntry
    active_count: u32
    active_scratch: *ActiveEntry
    // The next list, set by thread mode and taken at the start of a frame
    swap_cell: *DisplayList
    // The list replaced by the last swap, which thread mode then owns
    retired: *DisplayList
}

static mut render_state: RenderState

// The list before the first swap
#[link_section = ".ram"]
static empty_list = DisplayList {
    payload: Vec { ptr: 0, len: 0, cap: 0 },
    heads: Vec { ptr: 0, len: 0, cap: 0 },
}

struct DisplayObj {
    vtable: *DisplayVtable
    x0: u16
    y0: u16
    x1: u16
    y1: u16
}

// These are actually function pointers, but we haven't built out the types yet.
//
// start(obj) is called on the object's first line and end(obj) after its
// last; either may be 0. An object that needs scratch memory allocates it
// in start with pico_alloc and frees it in end. end isn't called for an
// object still active at the end of the frame, since pico_reset at the
// start of the next one reclaims everything.
struct DisplayVtable {
    render: *u8
    start: *u8
    end: *u8
}

struct ActiveEntry {
    obj: *DisplayObj
}

static mut active0: [ActiveEntry; 64]
static mut active1: [ActiveEntry; 64]

// to be called once before any rendering
fn render_init() {
    r @r0 = &render_state
    minusone @r1 = -1
    r.y = minusone
    list @r1 = &empty_list
    r.list = list
    bx lr
}

// Make list the display list from the next frame on. Called from thread
// mode. Waits until the renderer has taken it, then returns the list it
// replaced, which the caller then owns and can reuse.
//
// TODO: the swap is morally atomic, but it only uses plain loads and
// stores, which is enough while thread mode and the renderer share a
// core. If the app runs on the other core, we may need to use proper
// atomic ordering.
fn render_swap(list: *DisplayList) {
    r @r1 = &render_state
    r.swap_cell = list
    loop {
        cell @r0 = r.swap_cell
        if cell == 0 goto break
        // The renderer does sev after the swap, so one between the check
        // and the wfe isn't missed.
        wfe
        goto loop
    }
    retired @r0 = r.retired
    bx lr
}

#[link_section = ".ram"]
#[align = 4]
fn render_line(y: u32, buf: *u16) {
    push(buf, r4, r5, r6, r7, r8, r9, lr)
    r @r2 = &render_state
    r_y @r3 = r.y
    if {
        #(y - r_y)
        // A case we have to handle eventually is when y is ahead of r_y. This happens when
        // we miss the frame timing budget.
        //
        // For the time being, we *assume* this function is called with y starting at 0
        // and incrementing by 1 each scan line
        if #hs goto end
        push(y)
        call pico_reset()
        r @r2 = &render_state
        // Take the next list, if thread mode has set one. Nothing points
        // into the old one once the active list is cleared below.
        // TODO: atomics, see render_swap.
        cell @r0 = r.swap_cell
        if {
            if cell == 0 goto end
            old @r1 = r.list
            r.retired = old
            r.list = cell
            zero @r0 = 0
            r.swap_cell = zero
            sev
        }
        a0 @r0 = &active0
        r.active = a0
        a1 @r0 = &active1
        r.active_scratch = a1
        zero @r0 = 0
        r.active_count = zero
        r.display_head_ix = zero
        pop(y @r0)
    }
    ynext @r1 = y + 1
    r.y = ynext

    // update active list
    // TODO: keep track of "next y event", skip if not at event
    active_src @r1 = r.active
    active_dst @r7 = r.active_scratch
    active_count @r4 = r.active_count
    ix @r12 = r.display_head_ix
    list @r3 = r.list
    end @r9 = list.heads.len
    display_heads @r8 = list.heads.ptr
    display_payload @r2 = list.payload.ptr
    loop {
        // TODO: deal with overflow of active_dst
        if {
            #(ix - end)
            if #eq goto else
            obj_ix @r6 = *(display_heads + ix * 4)
            obj @r5 = (display_payload + (obj_ix << 2)) as *DisplayObj
            y0 @r6 = obj.y0
            #(y - y0)
            if #eq goto end
        } else {
            obj @r5 = -1
        }
        if {
            if active_count == 0 goto end
            // The common case, an active object that continues and comes
            // before obj, falls through.
            loop {
                active_obj @r3 = active_src.obj
                active_src += 4
                y1 @r6 = active_obj.y1
                #(y - y1)
                if #eq goto ending
                // have both active and (maybe) new obj, pick whichever is lower
                #(obj - active_obj)
                if #ls goto new_first
                *active_dst++ = active_obj
                #(active_count -= 1)
                if #ne goto loop // loop, but skip reloading obj
                goto no_more_active
ending:
                vtable @r6 = active_obj.vtable
                end_fn @r6 = vtable.end
                if {
                    if end_fn == 0 goto end
                    push(y, active_src, display_payload, ix)
                    obj_arg @r0 = active_obj
                    blx end_fn
                    pop(y @r0, active_src @r1, display_payload @r2, ix @r12)
                }
                #(active_count -= 1)
                if #ne goto loop
                goto no_more_active
            }
new_first:
            // active_obj stays active, and is looked at again
            active_src -= 4
store_obj:
            *active_dst++ = obj
            ix += 1
            goto loop
        }
no_more_active:
        #(_ @r6 = obj + 1)
        if #ne goto store_obj
    }

    // iterate from display_head_ix to ix (all the newly added objs), calling start
    r @r9 = &render_state
    old_ix @r6 = r.display_head_ix
    while {
        #(ix - old_ix)
        if #eq goto break
    } loop {
        obj_ix @r5 = *(display_heads + old_ix * 4)
        obj @r5 = (display_payload + (obj_ix << 2)) as *DisplayObj
        vtable @r4 = obj.vtable
        start @r4 = vtable.start
        if {
            if start == 0 goto end
            push(y, display_payload, ix)
            obj_arg @r0 = obj
            nop
            blx start
            pop(y @r0, display_payload @r2, ix @r12)
        }
        old_ix += 1
        #(ix - old_ix)
        if #ne goto loop
    }

    active @r6 = r.active_scratch
    r.display_head_ix = ix
    active_count @r4 = active_dst - active
    // swap active and scratch
    active_count >>= 2
    r.active_count = active_count
    active_scratch @r5 = r.active
    r.active = active
    r.active_scratch = active_scratch
    active_end @r7 = active_dst
    y @r5 = y
    nop

    // now actually run the rendering, taking another pass over active list
    while {
        #(active - active_end)
        if #eq goto break // this is a problem, it means unwritten output
    } loop {
        active_obj @r0 = active.obj
        active += 4
        // ordered so that no load result is used by the next instruction
        vtable @r4 = active_obj.vtable
        x0 @r2 = active_obj.x0
        nop
        render @r4 = vtable.render
        x1 @r1 = active_obj.x1
        buf @r3 = sp.buf
        x0x1 @r2 = pkhbt(x0, x1 << 16)
        y_arg @r1 = y
        blx render

        #(active - active_end)
        if #ne goto loop
    }

    pop(r1, r4, r5, r6, r7, r8, r9, pc)
}

// solid color rendering

struct Solid {
    // should the first 5 elements be a `DrawBase` struct?
    vtable: *DisplayVtable
    x0: u16
    y0: u16
    x1: u16
    y1: u16
    color: u32
}

#[link_section = ".ram"]
fn solid_render(self: *Solid, y: u32, x1x0: u32, buf: *u16) {
    color @r1 = self.color
    x0 @r0 = x1x0[0..16]
    x1 @r2 = x1x0[16..32]
    count @r2 = x1 - x0
    dst @r0 = buf + x0 * 2
    #[tail] call fill_16(dst, color, count)
}

#[link_section = ".ram"]
static solid_vtable = DisplayVtable {
    render: solid_render,
    start: 0,
    end: 0,
}

// sprite rendering

// A rectangle of RGB565 pixels, drawn over what's below it, with 0 being
// transparent; use 0x0001 for black. The pixels are read from the render
// interrupt, so they belong in RAM. The object's rectangle has to be on the
// screen, and pixels is the one for its top left corner: to clip, make the
// rectangle smaller and move pixels along. stride is the bytes from a row
// to the next.
struct Sprite {
    vtable: *DisplayVtable
    x0: u16
    y0: u16
    x1: u16
    y1: u16
    pixels: *u16
    stride: u32
}

// 6 cycles per pixel, but for the stall of a store after a store.
#[link_section = ".ram"]
fn sprite_render(self: *Sprite, y: u32, x1x0: u32, buf: *u16) {
    y0 @r12 = self.y0
    row @r1 = y - y0
    stride @r12 = self.stride
    src @r0 = self.pixels
    row *= stride
    x0 @r12 = x1x0[0..16]
    x1 @r2 = x1x0[16..32]
    src += row
    count @r2 = x1 - x0
    dst @r3 = buf + x0 * 2
    loop {
        px @r1 = *src++
        // fills the load's delay slot
        dst += 2
        #(px - 0)
        if #ne {
            *(dst - 2) = px
        }
        #(count -= 1)
        if #ne goto loop
    }
    bx lr
}

#[link_section = ".ram"]
static sprite_vtable = DisplayVtable {
    render: sprite_render,
    start: 0,
    end: 0,
}
